+                dev_err(dev, "max96712 power on MX6800 :link %d failed \n", i);
+                continue;
+                //break;
+            }
+            dev_info(dev, "%s power on MX6800 :link %d success\n", __func__, i);
+        }
+    }
+    mutex_unlock(&priv->lock);
+
+    dev_info(dev, "%s : sleep 3(s) after power on MX6800\n", __func__);
+    msleep(3000);
+    return err;
+}
+#endif
