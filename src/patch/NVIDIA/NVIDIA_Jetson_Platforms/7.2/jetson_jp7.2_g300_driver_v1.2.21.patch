+/**
+ * max96712_write_reg - Write single register
+ * @dev: device handle
+ * @addr: register address
+ * @val: value to write
+ * Return: 0 on success, error code on failure
+ */
+static int max96712_write_reg(struct device *dev, u16 addr, u8 val)
+{
+    struct max96712 *priv = dev_get_drvdata(dev);
+    int err;
+    static const u16 link_ctrl_addrs[] = {
+        MAX96712_LINK_RESET_ADDR, MAX96712_CTRL0_ADDR, MAX96712_CTRL2_ADDR,
+        MAX96712_LINK_EN_MODE_ADDR, MAX96712_LINK_AB_RATE_ADDR, MAX96712_LINK_CD_RATE_ADDR,
+        MAX96712_PWR1_RESET_ALL_ADDR,
+    };
+    u16 i;
+
+    if (!dev || !priv || !priv->regmap) {
+        dev_err(dev, "%s: invalid parameters (dev=%p priv=%p regmap=%p)\n",
+                __func__, dev, priv, priv ? priv->regmap : NULL);
+        return -EINVAL;
+    }
+
+    mutex_lock(&priv->lock);
+    err = __max96712_reg_write(priv, addr, val);
+    for (i = 0; i < ARRAY_SIZE(link_ctrl_addrs); i++) {
+        if (addr == link_ctrl_addrs[i]) {
+            msleep(200);
+            break;
+        }
+    }
+    mutex_unlock(&priv->lock);
+
+    return err;
+}
+
+/**
+ * max96712_read_reg - Read single register
+ * @dev: device handle
+ * @addr: register address
+ * @val: output pointer for read result
+ * Return: 0 on success, error code on failure
+ */
+static int max96712_read_reg(struct device *dev, u16 addr, u8 *val)
+{
+    struct max96712 *priv = dev_get_drvdata(dev);
+    int err;
+
+    if (!dev || !priv || !priv->regmap || !val) {
+        dev_err(dev, "%s: invalid parameters (dev=%p priv=%p regmap=%p val=%p)\n",
+                __func__, dev, priv, priv ? priv->regmap : NULL, val);
+        return -EINVAL;
+    }
+
+    mutex_lock(&priv->lock);
+    err = __max96712_reg_read(priv, addr, val);
+    mutex_unlock(&priv->lock);
+
+    return err;
+}
+
+static int max96712_set_registers(struct device *dev, struct max_reg_pair *map, u16 count)
+{
+    int err = 0;
+    u16 i;
+
+    for (i = 0; i < count; i++) {
+        err = max96712_write_reg(dev, map[i].addr, map[i].val);
+        if (err != 0)
+            break;
+    }
+
+    return err;
+}
