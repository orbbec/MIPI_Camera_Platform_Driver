+typedef enum
+{
+    MODE_SYNC_IN,
+    MODE_SYNC_OUT
+} cs_mode_e;
+
+typedef enum
+{
+    NO_TRIGGER,
+    GPIO_TRIGGER,
+    PWM_TRIGGER
+} trigger_type_t;
+
+typedef struct
+{
+    uint8_t mode;
+    uint16_t fps;
+} cs_param_t;
