+/* Internal I2C helper with retry, caller must hold priv->lock and set i2c_client->addr */
+static int __max96712_reg_write(struct max96712 *priv, u16 addr, u8 val)
+{
+    int err, retry;
+
+    for (retry = 0; retry < ORBBEC_I2C_RETRY_CNT; retry++) {
+        err = regmap_write(priv->regmap, addr, val);
+        if (err == 0) {
+            dev_dbg(&priv->i2c_client->dev, "[dser 0x%02x] i2c wr: 0x%04x = 0x%02x\n", priv->i2c_client->addr, addr, val);
+            usleep_range(100, 150);
+            return 0;
+        }
+        dev_warn(&priv->i2c_client->dev, "max96712 write reg 0x%04x = %02x fail, err=%d, retry=%d\n", addr, val, err, retry);
+        usleep_range(MAX96712_RETRY_DELAY_US, MAX96712_RETRY_DELAY_US + 50);
+    }
+    dev_err(&priv->i2c_client->dev, "max96712 write reg 0x%04x = %02x fail, err=%d\n", addr, val, err);
+    return err;
+}
+
+static int __max96712_reg_read(struct max96712 *priv, u16 addr, u8 *val)
+{
+    unsigned int value;
+    int err, retry;
+
+    for (retry = 0; retry < ORBBEC_I2C_RETRY_CNT; retry++) {
+        err = regmap_read(priv->regmap, addr, &value);
+        if (err == 0) {
+            *val = value & 0xff;
+            dev_dbg(&priv->i2c_client->dev, "[dser 0x%02x] i2c rd: 0x%04x = 0x%02x\n", priv->i2c_client->addr, addr, *val);
+            usleep_range(100, 150);
+            return 0;
+        }
+        dev_warn(&priv->i2c_client->dev, "max96712 read reg 0x%04x fail, err=%d, retry=%d\n", addr, err, retry);
+        usleep_range(MAX96712_RETRY_DELAY_US, MAX96712_RETRY_DELAY_US + 50);
+    }
+    *val = 0;
+    dev_err(&priv->i2c_client->dev, "max96712 read reg 0x%04x fail, err=%d\n", addr, err);
+    return err;
+}
