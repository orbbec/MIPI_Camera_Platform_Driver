+    GMSL_STATUS_DESER_DEPTH_PIPE_LINE_MEM_ERR        = (1ULL << 10),   // 解串器深度PIPE行内存错误：0=无错误，1=存在错误
+	GMSL_STATUS_SER_COLOR_PIPE_PCLK_UNDETECTED       = (1ULL << 11),   // 串行器RGB PIPE PCLK检测：0=检测到，1=未检测到
+    GMSL_STATUS_SER_COLOR_PIPE_OVERFLOW              = (1ULL << 12),   // 串行器RGB PIPE带宽溢出：0=正常，1=溢出
+    GMSL_STATUS_SER_COLOR_PIPE_DRIFT_ERR             = (1ULL << 13),   // 串行器RGB PIPE PCLK漂移错误：0=正常，1=错误
+    GMSL_STATUS_DESER_COLOR_PIPE_VID_UNLOCK          = (1ULL << 14),   // 解串器RGB视频PIPE锁定：0=已锁定，1=未锁定
+    GMSL_STATUS_DESER_COLOR_PIPE_PKT_UNDETECTED      = (1ULL << 15),   // 解串器RGB PIPE数据包检测：0=检测到充足的数据包，1=未检测到充足的数据包
+    GMSL_STATUS_DESER_COLOR_PIPE_LINE_CRC_ERR        = (1ULL << 16),   // 解串器RGB PIPE行CRC_ERR错误：0=无错误，1=存在错误
+    GMSL_STATUS_DESER_COLOR_PIPE_LINE_MEM_ERR        = (1ULL << 17),   // 解串器RGB PIPE行内存错误：0=无错误，1=存在错误
+	GMSL_STATUS_SER_IR_L_PIPE_PCLK_UNDETECTED        = (1ULL << 18),   // 串行器IR_L PIPE PCLK检测：0=检测到，1=未检测到
+    GMSL_STATUS_SER_IR_L_PIPE_OVERFLOW               = (1ULL << 19),   // 串行器IR_L PIPE带宽溢出：0=正常，1=溢出
+    GMSL_STATUS_SER_IR_L_PIPE_DRIFT_ERR              = (1ULL << 20),   // 串行器IR_L PIPE PCLK漂移错误：0=正常，1=错误
+    GMSL_STATUS_DESER_IR_L_PIPE_VID_UNLOCK           = (1ULL << 21),   // 解串器IR_L视频PIPE锁定：0=已锁定，1=未锁定
+    GMSL_STATUS_DESER_IR_L_PIPE_PKT_UNDETECTED       = (1ULL << 22),   // 解串器IR_L PIPE数据包检测：0=检测到充足的数据包，1=未检测到充足的数据包
