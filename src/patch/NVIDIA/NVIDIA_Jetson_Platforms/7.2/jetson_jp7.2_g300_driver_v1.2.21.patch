+    cmd->_data[4] = offset;
+    cmd->_data[5] = offset >> 8;
+    cmd->_data[6] = offset >> 16;
+    cmd->_data[7] = offset >> 24;
+    cmd->_data[8] = length;
+    cmd->_data[9] = length >> 8;
