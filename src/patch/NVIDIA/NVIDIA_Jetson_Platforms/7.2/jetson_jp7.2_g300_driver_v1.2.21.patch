+/**
+ * max9296a_write_reg_with_addr - Write single register with I2C address
+ * @dev: device handle
+ * @i2c_addr: target I2C slave address
+ * @addr: register address
+ * @val: value to write
+ * Return: 0 on success, error code on failure
+ */
+static int max9296a_write_reg_with_addr(struct device *dev, u8 i2c_addr, u16 addr, u8 val)
+{
+    struct max9296a *priv = dev_get_drvdata(dev);
+    int err;
+
+    if (priv == NULL || dev == NULL) {
+        dev_err(dev, "%s: invalid parameters (priv=%p dev=%p)\n", __func__, priv, dev);
+        return -EINVAL;
+    }
+
+    mutex_lock(&priv->lock);
+    priv->i2c_client->addr = i2c_addr;
+    err = __max9296a_reg_write(priv, addr, val);
+    priv->i2c_client->addr = priv->deser_addr;
+    mutex_unlock(&priv->lock);
+
+    return err;
+}
+
+/**
+ * max9296a_write_tab_with_addr - Write register table with I2C address
+ * @dev: device handle
+ * @i2c_addr: target I2C slave address
+ * @tab: register key-value pair array
+ * @size: array length
+ * Return: 0 on success, error code on failure (first failed item)
+ */
+static int max9296a_write_tab_with_addr(struct device *dev, u8 i2c_addr, struct max_reg_pair tab[], u16 size)
+{
+    struct max9296a *priv = dev_get_drvdata(dev);
+    int i, err;
+
+    if (priv == NULL || dev == NULL || tab == NULL || size == 0) {
+        dev_err(dev, "%s: invalid parameters (priv=%p dev=%p tab=%p size=%d)\n",
+                __func__, priv, dev, tab, size);
+        return -EINVAL;
+    }
+
+    mutex_lock(&priv->lock);
+    priv->i2c_client->addr = i2c_addr;
+    for (i = 0; i < size; i++) {
+        err = __max9296a_reg_write(priv, tab[i].addr, tab[i].val);
+        if (err != 0) {
+            dev_err(dev, "%s: write tab reg 0x%04x (addr=0x%02x) failed after %d retries, err=%d\n",
+                    __func__, tab[i].addr, i2c_addr, ORBBEC_I2C_RETRY_CNT, err);
+            break;
+        }
+    }
+    priv->i2c_client->addr = priv->deser_addr;
+    mutex_unlock(&priv->lock);
+
+    return err;
+}
+
+/**
+ * max9296a_read_reg_with_addr - Read single register with I2C address
+ * @dev: device handle
+ * @i2c_addr: target I2C slave address
+ * @addr: register address
+ * @val: output pointer for read result
+ * Return: 0 on success, error code on failure
+ */
+static int max9296a_read_reg_with_addr(struct device *dev, u8 i2c_addr, u16 addr, u8 *val)
+{
+    struct max9296a *priv = dev_get_drvdata(dev);
+    int err;
+
+    if (priv == NULL || dev == NULL || val == NULL) {
+        dev_err(dev, "%s: invalid parameters (priv=%p dev=%p val=%p)\n",
+                __func__, priv, dev, val);
+        return -EINVAL;
+    }
+
+    mutex_lock(&priv->lock);
+    priv->i2c_client->addr = i2c_addr;
+    err = __max9296a_reg_read(priv, addr, val);
+    priv->i2c_client->addr = priv->deser_addr;
+    mutex_unlock(&priv->lock);
+
+    return err;
+}
