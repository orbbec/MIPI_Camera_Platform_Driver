+ *   @max_freq_hz_lcm: Maximum frequency (hz) of the common base generator period.
+ * @offset:
+ *   @enabled: Allow generators to offset their signal from the start of their period.
+ */
+struct tsc_signal_controller_features {
+	u32 ns_per_tick;
+	bool is_thor;
+	struct {
