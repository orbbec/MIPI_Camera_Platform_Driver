+int max96712_get_link_state(struct device *dev, u8 link_id, int *value)
+{
+    int ret;
+
+    ret = max96712_read_link_lock(dev, link_id);
+    if(ret >= 0)
+        *value = ret;
+
+    dev_info(dev, "%s, %d\n", __func__, ret);
+
+    return ret;
+}
+EXPORT_SYMBOL(max96712_get_link_state);
