+/**
+ * max9296a_write_reg - Write single register
+ * @dev: device handle
+ * @addr: register address
+ * @val: value to write
+ * Return: 0 on success, error code on failure
+ */
+static int max9296a_write_reg(struct device *dev, u16 addr, u8 val)
+{
+    struct max9296a *priv = dev_get_drvdata(dev);
+    int err;
+
+    if (!dev || !priv || !priv->regmap) {
+        dev_err(dev, "%s: invalid parameters (dev=%p priv=%p regmap=%p)\n",
+                __func__, dev, priv, priv ? priv->regmap : NULL);
+        return -EINVAL;
+    }
+
+    mutex_lock(&priv->lock);
+    err = __max9296a_reg_write(priv, addr, val);
+    mutex_unlock(&priv->lock);
+
+    if (addr == MAX9296_CTRL0_ADDR || addr == MAX9296_CTRL2_ADDR || addr == MAX9296_REG1_ADDR)
+        msleep(200); /* delay to settle link */
+
+    return err;
+}
+
+/**
+ * max9296a_read_reg - Read single register
+ * @dev: device handle
+ * @addr: register address
+ * @val: output pointer for read result
+ * Return: 0 on success, error code on failure
+ */
+static int max9296a_read_reg(struct device *dev, u16 addr, u8 *val)
+{
+    struct max9296a *priv = dev_get_drvdata(dev);
+    int err;
+
+    if (!dev || !priv || !priv->regmap || !val) {
+        dev_err(dev, "%s: invalid parameters (dev=%p priv=%p regmap=%p val=%p)\n",
+                __func__, dev, priv, priv ? priv->regmap : NULL, val);
+        return -EINVAL;
+    }
+
+    mutex_lock(&priv->lock);
+    err = __max9296a_reg_read(priv, addr, val);
+    mutex_unlock(&priv->lock);
+
+    return err;
+}
