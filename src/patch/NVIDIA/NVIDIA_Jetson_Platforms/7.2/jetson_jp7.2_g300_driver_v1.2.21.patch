+#define UPDATE_GMSL_STATUS(_status, _cond, _flag, _set) \
+    do { \
+        if ((_cond) == (_set)) { \
+            *(_status) |= (_flag); \
+        } else { \
+            *(_status) &= ~(_flag); \
+        } \
+    } while (0)
+
+// Link A-D decode error register address table
+static const u16 g_dec_err_reg_tab[] = {
+    [ORB_LINKA] = MAX9296_DEC_ERR_A_ADDR,
+    [ORB_LINKB] = MAX9296_DEC_ERR_B_ADDR,
+};
+/**
+ * max9296a_get_gmsl_status - Get MAX9296 deserializer GMSL status
+ * @dev: deserializer device (orb->dser_dev)
+ * @cam_type: camera type (orb_cam_type_e)
+ * @link_id: GMSL link ID (A/B/C/D, orb->dser_link)
+ * @pipe_id: PIPE ID (GMSL data channel)
+ * @status: output param, all GMSL status bits (64-bit)
+ *
+ * Implements orb_deser_ops->get_gmsl_status
+ */
+int max9296a_get_gmsl_status(struct device *dev, orb_cam_type_e cam_type,
+                             u8 link_id, u8 pipe_id, __u64 *status)
+{
+    struct max9296a *priv = dev_get_drvdata(dev);
+    const struct cam_status_bits *status_bits;
+    int ret = 0;
+    int link_state;
+    u8 val;
+
+    if (!dev || !status || link_id >= MAX9296_MAX_LINKS ||
+        pipe_id >= MAX9296_MAX_PIPES || cam_type >= ORB_CAM_TYPE_COUNT) {
+        dev_err(dev, "invalid param: dev=%p cam_type=%d link_id=%d pipe_id=%d\n",
+                dev, cam_type, link_id, pipe_id);
+        return -EINVAL;
+    }
+    status_bits = &g_cam_status_map[cam_type];
+
+    ret = max9296a_get_link_state(dev, link_id, &link_state);
+    if (ret) {
+        dev_err(dev, "get link %d state failed,(ret=%d)\n", link_id, ret);
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    } else {
+        if (link_state) {
+            UPDATE_GMSL_STATUS(status, link_state, GMSL_STATUS_LINK_UNLOCKED, 0);
+            dev_dbg(dev, "LINK %d LOCKED\n", link_id);
+        } else {
+            UPDATE_GMSL_STATUS(status, link_state, GMSL_STATUS_LINK_UNLOCKED, 1);
+            dev_warn(dev, "LINK %d UNLOCKED\n", link_id);
+        }
+    }
+
+    // Read SER PIPE status
+    ret = max9296a_read_reg_with_addr(dev, TO_SERI_ADDR(link_id), g_ser_pipe_status_addr_tab[pipe_id], &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d SER pipe status:0x%04x = 0x%02x\n", link_id, cam_type, g_ser_pipe_status_addr_tab[pipe_id], val);
+        UPDATE_GMSL_STATUS(status, (val & SER_PIPE_PCLK_DET_BIT), status_bits->pclk_undetected, 0);
+        UPDATE_GMSL_STATUS(status, (val & SER_PIPE_DRIFT_ERR_BIT), status_bits->drift_err, 1);
+        UPDATE_GMSL_STATUS(status, (val & SER_PIPE_OVERFLOW_BIT), status_bits->overflow, 1);
+    } else {
+        *status |= GMSL_STATUS_SER_I2C_STATUS_ERR;
+    }
+
+    // Read DESER PIPE status
+    ret = max9296a_read_reg(dev, g_deser_pipe_status_addr_tab[pipe_id], &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d DESER pipe status:0x%04x = 0x%02x\n", link_id, cam_type, g_deser_pipe_status_addr_tab[pipe_id], val);
+        UPDATE_GMSL_STATUS(status, (val & DESER_PIPE_VID_LOCK_BIT), status_bits->vid_unlock, 0);
+        UPDATE_GMSL_STATUS(status, (val & DESER_PIPE_PKT_DET_BIT), status_bits->pkt_undetected, 0);
+    } else {
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    // Read DESER PIPE CRC status
+    ret = max9296a_read_reg(dev, g_deser_pipe_crc_status_addr_tab[pipe_id], &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d DESER CRC status:0x%04x = 0x%02x\n", link_id, cam_type, g_deser_pipe_crc_status_addr_tab[pipe_id], val);
+        UPDATE_GMSL_STATUS(status, (val & DESER_PIPE_LINE_CRC_BIT), status_bits->line_crc_err, 1);
+    } else {
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    // Read BACKTOP1 - CSI PLL lock status
+    ret = max9296a_read_reg(dev, MAX9296_BACKTOP1_ADDR, &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d BACKTOP1:0x%04x = 0x%02x\n", link_id, cam_type, MAX9296_BACKTOP1_ADDR, val);
+        UPDATE_GMSL_STATUS(status, (val & MAX9296_CSIPLL_LOCK_BIT), GMSL_STATUS_MIPI_PLL_UNLOCKED, 0);
+    } else {
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    // Read MIPI_PHY9 - FIFO overflow status
+    ret = max9296a_read_reg(dev, MAX9296_MIPI_PHY9_ADDR, &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d MIPI_PHY9:0x%04x = 0x%02x\n", link_id, cam_type, MAX9296_MIPI_PHY9_ADDR, val);
+        UPDATE_GMSL_STATUS(status, (val & MAX9296_MIPI_PHY_STATUS_BIT), GMSL_STATUS_MIPI_FIFO_OVERFLOW, 1);
+    } else {
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    // Read MIPI_PHY10 - FIFO underflow status
+    ret = max9296a_read_reg(dev, MAX9296_MIPI_PHY10_ADDR, &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d MIPI_PHY10:0x%04x = 0x%02x\n", link_id, cam_type, MAX9296_MIPI_PHY10_ADDR, val);
+        UPDATE_GMSL_STATUS(status, (val & MAX9296_MIPI_PHY_STATUS_BIT), GMSL_STATUS_MIPI_FIFO_UNDERFLOW, 1);
+    } else {
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    ret = max9296a_read_reg(dev, MAX9296_DEC_ERR_FLG_ADDR, &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d DEC_ERR_FLG:0x%04x = 0x%02x\n", link_id, cam_type, MAX9296_DEC_ERR_FLG_ADDR, val);
+        if (val & (MAX9296_DEC_ERR_FLG_BIT << link_id)) {
+            ret = max9296a_read_reg(dev, g_dec_err_reg_tab[link_id], &val);
+            if (!ret) {
+                dev_info(dev, "link%d cam%d DEC_ERR:0x%04x = 0x%02x\n", link_id, cam_type, g_dec_err_reg_tab[link_id], val);
+                UPDATE_GMSL_STATUS(status, (val > 0), GMSL_STATUS_LINK_DEC_ERR, 1);
+            } else {
+                *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+            }
+        } else {
+            UPDATE_GMSL_STATUS(status, 0, GMSL_STATUS_LINK_DEC_ERR, 1);
+        }
+    }
+
+    // Read INTR5_FLG - EOM error status
+    ret = max9296a_read_reg(dev, MAX9296_INTR5_FLG_ADDR, &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d INTR5_FLG:0x%04x = 0x%02x\n", link_id, cam_type, MAX9296_INTR5_FLG_ADDR, val);
+        UPDATE_GMSL_STATUS(status, (val & (MAX9296_LINKA_EOM_ERR_FLG_BIT << link_id)), GMSL_STATUS_LINK_EOM_ERR_FLAG, 1);
+    } else {
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    // Read CTRL3 - ERRB status
+    ret = max9296a_read_reg(dev, MAX9296_CTRL3_ADDR, &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d CTRL3:0x%04x = 0x%02x\n", link_id, cam_type, MAX9296_CTRL3_ADDR, val);
+        UPDATE_GMSL_STATUS(status, (val & CTRL3_ERRB_ASSERTED), GMSL_STATUS_DESER_ERRB_ASSERTED, 1);
+    } else {
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    return ret;
+}
+EXPORT_SYMBOL(max9296a_get_gmsl_status);
+
