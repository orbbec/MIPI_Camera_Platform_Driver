+/* transform serializer i2c address */
+static int max96712_seri_i2c_addr_trans(struct device *dev)
+{
+    struct max96712 *priv = dev_get_drvdata(dev);
+    int i, ret, links;
+    u16 mask = 0xF0;
+
+    links = max96712_check_link_lock(dev);
+    if(links <= 0) {
+        dev_err(dev, "max96712_check_link_lock failed %d\n", links);
+        ret = links;
+        goto err;
+    }
+
+    /*Configure only the link(s) connected to the Orbbec camera.*/
+    priv->links_map = links & priv->link_mask;
+    priv->links_init_flag = priv->links_map;
+
+    ret = max96712_write_reg(dev, 0x40B, 0x00); //CSI_OUT_EN = 0, CSI output disabled
+    if (ret)
+        goto err;
+    ret = max96712_write_reg(dev, MAX96712_LINK_RESET_ADDR, 0x0F); //reset link A~D oneshot
+    if (ret)
+        goto err;
+
+    for (i = 0; i < MAX96712_MAX_LINKS; i++) { //link A~D
+        if(priv->links_map & (1<<i)) {
+            mask |= (1<<i);
+            /* max96712 */
+            ret = max96712_write_reg(dev, MAX96712_LINK_EN_MODE_ADDR, mask); //enable link A~D
+            if (ret)
+                goto err;
+            /* max9295d */
+            ret = max96712_write_reg_with_addr(dev, SERI_DEFAULT_ADDR, 0x0002, 0); //disable all pipe out
+            ret = max96712_write_reg_with_addr(dev, SERI_DEFAULT_ADDR, 0x0000, TO_SERI_ADDR(i)<<1); //transform serializer i2c address
+
+            dev_info(dev, "transf seri i2c addr, 0x%02x, 0x40 -> 0x%02x\n", mask, TO_SERI_ADDR(i));
+        }
+    }
+
+    ret = max96712_write_reg(dev, 0x40B, 0x02); //CSI_OUT_EN = 1, CSI output enabled
+    if (ret)
+        goto err;
+
+    ret = max96712_write_reg(dev, MAX96712_LINK_EN_MODE_ADDR, mask | links); // enable all link A~D
+    if (ret)
+        goto err;
+
+    if(priv->vdd_supply_1v2 == 1) { //Enable regulator manual mode to allow regulator to be forced on or off via REG_ENABLE
+        max96712_write_reg(dev, MAX96712_CTRL0_ADDR, 0x10|CTRL0_REG_ENABLE);
+        max96712_write_reg(dev, MAX96712_CTRL2_ADDR, 0x84|CTRL0_REG_MNL);
+    }
+
+err:
+    return ret;
+}
