+MODULE_DEVICE_TABLE(of, max96712_of_match);
+
+static int max96712_parse_dt(struct max96712 *priv, struct i2c_client *client)
+{
+    struct device_node *node = client->dev.of_node;
+    const struct of_device_id *match;
+    const char *str_value;
+    int value, err = 0;
+
+    if (!node)
+        return -EINVAL;
+
+    match = of_match_device(max96712_of_match, &client->dev);
+    if (!match) {
+        dev_err(&client->dev, "Failed to find matching dt id\n");
+        return -EFAULT;
+    }
+
+    err = of_property_read_u32(node, "index", &value);
+    if (err) {
+        dev_err(&client->dev, "index not found\n");
+        value = 0;
+    }
+        
+
+    if(value >= 0 && value < 4)
+        priv->index = value;
+    else
+        priv->index = 0;
+
+    dev_dbg(&client->dev, "%s: index %d\n", __func__, priv->index);
+
+    err = of_property_read_string(node, "num_lanes", &str_value);
+    if (err < 0) {
+        dev_err(&client->dev, "num_lanes property not found\n");
+        priv->num_lanes = 4;
+    }else {
+        priv->num_lanes = str_value[0] - '0';
+    }
+    
+    dev_info(&client->dev, "%s: num_lanes %d\n", __func__, priv->num_lanes);
+
+    err = of_property_read_string(node, "csi-mode", &str_value);
+    if (err < 0) {
+        dev_err(&client->dev, "csi-mode property not found\n");
+        priv->csi_mode = MAX96712_CSI_MODE_2X4;
+    }
+
+    if (!strcmp(str_value, "2x4")) {
+        priv->csi_mode = MAX96712_CSI_MODE_2X4;
+    } else if (!strcmp(str_value, "4x2")) {
+        priv->csi_mode = MAX96712_CSI_MODE_4X2;
+    } else {
+        priv->csi_mode = MAX96712_CSI_MODE_2X4;
+        dev_err(&client->dev, "invalid csi mode\n");
+    }
+
+    err = of_property_read_string(node, "port_a_clk", &str_value);
+    if (err < 0) {
+        dev_err(&client->dev, "port_a_clk property not found\n");
+        priv->port_a_clk = CKA_P_N;
+    }else {
+        // Use strcmp for full string comparison, avoid multi-character constants
+        if (strcmp(str_value, "CKA") == 0) {
+            priv->port_a_clk = CKA_P_N;
+        } else if (strcmp(str_value, "CKB") == 0) {
+            priv->port_a_clk = CKB_P_N;
+        } else if (strcmp(str_value, "CKC") == 0) {
+            priv->port_a_clk = CKC_P_N;
+        } else if (strcmp(str_value, "CKD") == 0) {
+            priv->port_a_clk = CKD_P_N;
+        } else if (strcmp(str_value, "CKE") == 0) {
+            priv->port_a_clk = CKE_P_N;
+        } else if (strcmp(str_value, "CKF") == 0) {
+            priv->port_a_clk = CKF_P_N;
+        } else {
+            // Unknown string, use default value
+            dev_warn(&client->dev, "port_a_clk %s is invalid, use default CKA_P_N\n", str_value);
+            priv->port_a_clk = CKA_P_N;
+        }
+    }
+
+    if (of_get_property(node, "is_port_b_connected", NULL)) {
+        priv->is_port_b_connected = 1;
+    } else {
+        priv->is_port_b_connected = 0;
+    }
+
+    err = of_property_read_u32(node, "mipi_rate", &value);
+    if (err) {
+        priv->mipi_rate = 0x0F;
+        dev_err(&client->dev, "mipi_rate not found, use default 1.5G\n");
+    } else {
+        if (value > 0 && value <= 25)
+            priv->mipi_rate = value;
+        else {
+            priv->mipi_rate = 0x0F;
+            dev_err(&client->dev, "mipi_rate %d is invalid, use default 1.5G\n", value);
+        }
+    }
+
+    err = of_property_read_u32(node, "seri-addr", &value);
+    if (err) {
+        priv->seri_start_addr = 0x48;
+        dev_err(&client->dev, "seri-addr not found\n");
+    } else {
+        priv->seri_start_addr = value;
+    }
+        
+    err = of_property_read_u32(node, "proxy-addr", &value);
+    if (err) {
+        priv->snr_proxy_addr = 0x20;
+        dev_err(&client->dev, "proxy-addr not found\n");
+    } else {
+        priv->snr_proxy_addr = value;
+    }
+
+    err = of_property_read_u32(node, "real-addr", &value);
+    if (err) {
+        priv->snr_real_addr = 0x66;
+        dev_err(&client->dev, "real-addr not found\n");
+    } else {
+        priv->snr_real_addr = value;
+    }
+
+    err = of_property_read_u32(node, "link_mask", &value);
+    if (err) {
+        priv->link_mask = 0x0F;
+        dev_err(&client->dev, "link_mask not found\n");
+    } else {
+        priv->link_mask = value;
+    }
+
+    dev_info(&client->dev, "link_mask: 0x%02x\n", priv->link_mask);
+
+    err = of_property_read_u32(node, "fsync_mfp_index", &value);
+    if (err < 0) {
+        priv->fsync_mfp_x = 2;
+        dev_err(&client->dev, "No fsync_mfp_index info\n");
+    } else {
+        priv->fsync_mfp_x = value;
+    }
+
+    err = of_property_read_u32(node, "pps_mfp_index", &value);
+    if (err < 0) {
+        priv->pps_mfp_x = 9;
+        dev_err(&client->dev, "No pps_mfp_index info\n");
+    } else {
+        priv->pps_mfp_x = value;
+    }
+
+    priv->reset_gpio = of_get_named_gpio(node, "reset-gpios", 0);
+    if (priv->reset_gpio < 0)
+        dev_err(&client->dev, "reset-gpios not found %d\n", err);
+
+    if (of_get_property(node, "vdd_supply_1v2", NULL)) {
+        priv->vdd_supply_1v2 = 1;
+    } else {
+        priv->vdd_supply_1v2 = 0;
+    }
+
+    priv->deser_addr = client->addr;
+    return 0;
+}
+
+static struct regmap_config max96712_regmap_config = {
+    .reg_bits = 16,
+    .val_bits = 8,
+    .cache_type = REGCACHE_NONE, // REGCACHE_RBTREE,
+};
+
+#if defined(NV_I2C_DRIVER_STRUCT_PROBE_WITHOUT_I2C_DEVICE_ID_ARG) /* Linux 6.3 */
+static int max96712_probe(struct i2c_client *client)
+#else
+static int max96712_probe(struct i2c_client *client, const struct i2c_device_id *id)
+#endif
+{
+    struct max96712 *priv;
+    int err = 0;
+
+    dev_info(&client->dev, "%s: enter\n", __func__);
+
+    priv = devm_kzalloc(&client->dev, sizeof(*priv), GFP_KERNEL);
+    priv->i2c_client = client;
+    priv->regmap = devm_regmap_init_i2c(priv->i2c_client, &max96712_regmap_config);
+    if (IS_ERR(priv->regmap)) {
+        dev_err(&client->dev, "regmap init i2c failed: %ld\n", PTR_ERR(priv->regmap));
+        return -ENODEV;
+    }
+    dev_set_drvdata(&client->dev, priv);
+
+    err = max96712_parse_dt(priv, client);   //parse devicetree
+    if (err) {
+        dev_err(&client->dev, "parse devicetree error, %d\n", err);
+        return -EFAULT;
+    }
+
+    mutex_init(&priv->lock);
+
+    max96712_power_off(&client->dev);
+    msleep(400);
+    err = max96712_power_on(&client->dev);
+    if (err) {
+        dev_err(&client->dev, "power on failed, %d\n", err);
+        return err;
+    }
+    msleep(300);
+
+    err = max96712_debugfs_init(NULL, NULL, NULL, priv);
+    if (err)
+        return err;
+
+    /* Serializer i2c address trans */
+    err = max96712_seri_i2c_addr_trans(&client->dev);
+    if(err) {
+        dev_err(&client->dev, "Serializer i2c address change failed, %d\n", err);
+        return 0; //err;
+    }
+
+    err = max96712_init_settings(&client->dev);
+    if(err) {
+        dev_err(&client->dev, "max96712 init settings failed, %d\n", err);
+        return 0; //err;
+    }
+
+    err = max96712_set_snr_proxy_addr(&client->dev);
+    if(err) {
+        dev_err(&client->dev, "max96712 set_snr_proxy_addr failed, %d\n", err);
+        return 0; //err;
+    }
+
+    err = max96712_set_all_links_sensor_off(&client->dev);
+    if(err){
+        dev_err(&client->dev, "max96712_set_all_links_sensor_off failed, %d\n", err);
+        return 0; //err;
+    }
+    /*set daymode by fault*/
+    dev_info(&client->dev, "%s: success\n", __func__);
+
+    return 0; //err;
+}
+
+#if defined(NV_I2C_DRIVER_STRUCT_REMOVE_RETURN_TYPE_INT) /* Linux 6.1 */
+static int max96712_remove(struct i2c_client *client)
+#else
+static void max96712_remove(struct i2c_client *client)
+#endif
+{
+    struct max96712 *priv;
+
+    if (client != NULL) {
+        priv = dev_get_drvdata(&client->dev);
+        mutex_destroy(&priv->lock);
+        //i2c_unregister_device(client);
+        client = NULL;
+    }
+#if defined(NV_I2C_DRIVER_STRUCT_REMOVE_RETURN_TYPE_INT) /* Linux 6.1 */
+    return 0;
+#endif
+}
+
+static const struct i2c_device_id max96712_id[] = {
+    { "obc_max96712", 0 },
+    { },
+};
+MODULE_DEVICE_TABLE(i2c, max96712_id);
+
+static struct i2c_driver max96712_i2c_driver = {
+    .driver = {
+        .owner = THIS_MODULE,
+        .name = "obc_max96712",
+        .of_match_table = of_match_ptr(max96712_of_match),
+    },
+    .probe = max96712_probe,
+    .remove = max96712_remove,
+    .id_table = max96712_id,
+};
+
+module_i2c_driver(max96712_i2c_driver);
+
+MODULE_DESCRIPTION("IO Expander driver max96712");
+MODULE_AUTHOR("NVIDIA Corporation");
+MODULE_LICENSE("GPL v2");
diff --git a/Linux_for_Tegra/source/nvidia-oot/drivers/media/i2c/obcam.c b/Linux_for_Tegra/source/nvidia-oot/drivers/media/i2c/obcam.c
new file mode 100644
index 000000000..deb3e1c98
--- /dev/null
+++ b/Linux_for_Tegra/source/nvidia-oot/drivers/media/i2c/obcam.c
@@ -0,0 +1,591 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * obcam.c - Orbbec camera thin media graph driver
+ *
+ * Copyright (c) 2018-2024 FangzhuTech CORPORATION & AFFILIATES. All rights reserved.
+ */
+
+#include <nvidia/conftest.h>
+
+#include <linux/i2c.h>
+#include <linux/kernel.h>
+#include <linux/media.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/property.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/version.h>
+#include <linux/videodev2.h>
+
+#include <media/camera_common.h>
+#include <media/media-entity.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-mediabus.h>
+#include <media/v4l2-subdev.h>
+
+#define OBCAM_DRIVER_NAME "obcam"
+
+struct obcam_resolution {
+	u16 width;
+	u16 height;
+	u8 n_framerates;
+	const u16 *framerates;
+};
+
+struct obcam_format {
+	u32 mbus_code;
+	unsigned int n_resolutions;
+	const struct obcam_resolution *resolutions;
+};
+
+struct obcam_sensor_config {
+	const struct obcam_format *format;
+	const struct obcam_resolution *resolution;
+	u16 framerate;
+};
+
+struct obcam {
+	struct i2c_client *client;
+	struct camera_common_data s_data;
+	struct media_pad pad;
+	struct v4l2_mbus_framefmt format;
+	struct obcam_sensor_config config;
+	const struct obcam_format *formats;
+	unsigned int n_formats;
+	struct mutex lock;
+	char stable_name[64];
+	bool streaming;
+};
+
+static const u16 obcam_framerates_to_30[] = {
+	5, 10, 15, 20, 30,
+};
+
+static const u16 obcam_framerates_to_60[] = {
+	5, 10, 15, 20, 30, 60,
+};
+
+static const struct obcam_resolution obcam_depth_ir_resolutions[] = {
+	{ 1280, 800, ARRAY_SIZE(obcam_framerates_to_30), obcam_framerates_to_30 },
+	{ 1280, 720, ARRAY_SIZE(obcam_framerates_to_30), obcam_framerates_to_30 },
+	{ 848, 530, ARRAY_SIZE(obcam_framerates_to_60), obcam_framerates_to_60 },
+	{ 848, 480, ARRAY_SIZE(obcam_framerates_to_60), obcam_framerates_to_60 },
+	{ 640, 480, ARRAY_SIZE(obcam_framerates_to_60), obcam_framerates_to_60 },
+	{ 640, 400, ARRAY_SIZE(obcam_framerates_to_30), obcam_framerates_to_30 },
+	{ 640, 360, ARRAY_SIZE(obcam_framerates_to_30), obcam_framerates_to_30 },
+	{ 424, 266, ARRAY_SIZE(obcam_framerates_to_60), obcam_framerates_to_60 },
+	{ 424, 240, ARRAY_SIZE(obcam_framerates_to_60), obcam_framerates_to_60 },
+	{ 320, 240, ARRAY_SIZE(obcam_framerates_to_60), obcam_framerates_to_60 },
+	{ 320, 200, ARRAY_SIZE(obcam_framerates_to_30), obcam_framerates_to_30 },
+	{ 320, 180, ARRAY_SIZE(obcam_framerates_to_30), obcam_framerates_to_30 },
+};
+
+static const struct obcam_resolution obcam_rgb_resolutions[] = {
+	{ 1280, 800, ARRAY_SIZE(obcam_framerates_to_60), obcam_framerates_to_60 },
+	{ 1280, 720, ARRAY_SIZE(obcam_framerates_to_60), obcam_framerates_to_60 },
+	{ 848, 530, ARRAY_SIZE(obcam_framerates_to_60), obcam_framerates_to_60 },
+	{ 848, 480, ARRAY_SIZE(obcam_framerates_to_60), obcam_framerates_to_60 },
+	{ 640, 480, ARRAY_SIZE(obcam_framerates_to_60), obcam_framerates_to_60 },
+};
+
+static const struct obcam_format obcam_depth_formats[] = {
+	{
+		.mbus_code = MEDIA_BUS_FMT_YUYV8_1X16,
+		.n_resolutions = ARRAY_SIZE(obcam_depth_ir_resolutions),
+		.resolutions = obcam_depth_ir_resolutions,
+	},
+};
+
+static const struct obcam_format obcam_rgb_formats[] = {
+	{
+		.mbus_code = MEDIA_BUS_FMT_YUYV8_1X16,
+		.n_resolutions = ARRAY_SIZE(obcam_rgb_resolutions),
+		.resolutions = obcam_rgb_resolutions,
+	},
+};
+
+static const struct obcam_format obcam_ir_formats[] = {
+	{
+		.mbus_code = MEDIA_BUS_FMT_Y8_1X8,
+		.n_resolutions = ARRAY_SIZE(obcam_depth_ir_resolutions),
+		.resolutions = obcam_depth_ir_resolutions,
+	},
+};
+
+static const struct v4l2_mbus_framefmt obcam_mbus_framefmt_template = {
+	.field = V4L2_FIELD_NONE,
+	.colorspace = V4L2_COLORSPACE_SRGB,
+	.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT,
+	.quantization = V4L2_QUANTIZATION_DEFAULT,
+	.xfer_func = V4L2_XFER_FUNC_DEFAULT,
+};
+
+static const struct of_device_id obcam_of_match[] = {
+	{ .compatible = "orbbec,obcam" },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, obcam_of_match);
+
+static struct obcam *to_obcam(struct v4l2_subdev *sd)
+{
+	return v4l2_get_subdevdata(sd);
+}
+
+static void obcam_format_init(struct obcam *priv)
+{
+	const struct obcam_format *fmt = &priv->formats[0];
+	const struct obcam_resolution *res = &fmt->resolutions[0];
+	unsigned int i;
+
+	priv->format = obcam_mbus_framefmt_template;
+	priv->format.code = fmt->mbus_code;
+	priv->format.width = res->width;
+	priv->format.height = res->height;
+	priv->config.format = fmt;
+	priv->config.resolution = res;
+	priv->config.framerate = res->framerates[0];
+
+	for (i = 0; i < res->n_framerates; i++) {
+		if (res->framerates[i] == 30) {
+			priv->config.framerate = 30;
+			break;
+		}
+	}
+}
+
+static int obcam_enum_mbus_code(struct v4l2_subdev *sd,
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 15, 10)
+				struct v4l2_subdev_pad_config *cfg,
+#else
+				struct v4l2_subdev_state *state,
+#endif
+				struct v4l2_subdev_mbus_code_enum *mce)
+{
+	struct obcam *priv = to_obcam(sd);
+
+	if (mce->pad || mce->index >= priv->n_formats)
+		return -EINVAL;
+
+	mce->code = priv->formats[mce->index].mbus_code;
+
+	return 0;
+}
+
+static int obcam_enum_frame_size(struct v4l2_subdev *sd,
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 15, 10)
+				 struct v4l2_subdev_pad_config *cfg,
+#else
+				 struct v4l2_subdev_state *state,
+#endif
+				 struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct obcam *priv = to_obcam(sd);
+	const struct obcam_format *fmt;
+	unsigned int i;
+
+	if (fse->pad)
+		return -EINVAL;
+
+	for (i = 0, fmt = priv->formats; i < priv->n_formats; i++, fmt++) {
+		if (fse->code == fmt->mbus_code)
+			break;
+	}
+
+	if (i == priv->n_formats || fse->index >= fmt->n_resolutions)
+		return -EINVAL;
+
+	fse->min_width = fse->max_width = fmt->resolutions[fse->index].width;
+	fse->min_height = fse->max_height = fmt->resolutions[fse->index].height;
+
+	return 0;
+}
+
+static int obcam_enum_frame_interval(struct v4l2_subdev *sd,
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 15, 10)
+				     struct v4l2_subdev_pad_config *cfg,
+#else
+				     struct v4l2_subdev_state *state,
+#endif
+				     struct v4l2_subdev_frame_interval_enum *fie)
+{
+	struct obcam *priv = to_obcam(sd);
+	const struct obcam_format *fmt;
+	const struct obcam_resolution *res;
+	unsigned int i;
+
+	if (fie->pad)
+		return -EINVAL;
+
+	for (i = 0, fmt = priv->formats; i < priv->n_formats; i++, fmt++) {
+		if (fie->code == fmt->mbus_code)
+			break;
+	}
+
+	if (i == priv->n_formats)
+		return -EINVAL;
+
+	for (i = 0, res = fmt->resolutions; i < fmt->n_resolutions; i++, res++) {
+		if (res->width == fie->width && res->height == fie->height)
+			break;
+	}
+
+	if (i == fmt->n_resolutions || fie->index >= res->n_framerates)
+		return -EINVAL;
+
+	fie->interval.numerator = 1;
+	fie->interval.denominator = res->framerates[fie->index];
+
+	return 0;
+}
+
+static int obcam_get_fmt(struct v4l2_subdev *sd,
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 15, 10)
+			 struct v4l2_subdev_pad_config *cfg,
+#else
+			 struct v4l2_subdev_state *state,
+#endif
+			 struct v4l2_subdev_format *fmt)
+{
+	struct obcam *priv = to_obcam(sd);
+
+	if (fmt->pad)
+		return -EINVAL;
+
+	mutex_lock(&priv->lock);
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 15, 10)
+		fmt->format = *v4l2_subdev_get_try_format(sd, cfg, fmt->pad);
+#else
+		fmt->format = *v4l2_subdev_state_get_format(state, fmt->pad);
+#endif
+	else
+		fmt->format = priv->format;
+	mutex_unlock(&priv->lock);
+
+	return 0;
+}
+
+static const struct obcam_format *obcam_find_format(struct obcam *priv,
+						    struct v4l2_mbus_framefmt *ffmt,
+						    const struct obcam_resolution **best)
+{
+	const struct obcam_format *fmt;
+	const struct obcam_resolution *res;
+	unsigned long best_delta = ~0UL;
+	unsigned int i;
+
+	for (i = 0, fmt = priv->formats; i < priv->n_formats; i++, fmt++) {
+		if (fmt->mbus_code == ffmt->code)
+			break;
+	}
+
+	if (i == priv->n_formats)
+		fmt = &priv->formats[0];
+
+	for (i = 0, res = fmt->resolutions; i < fmt->n_resolutions; i++, res++) {
+		unsigned long delta = abs((int)(ffmt->width * ffmt->height -
+						res->width * res->height));
+
+		if (delta < best_delta) {
+			best_delta = delta;
+			*best = res;
+		}
+	}
+
+	ffmt->code = fmt->mbus_code;
+	ffmt->width = (*best)->width;
+	ffmt->height = (*best)->height;
+	ffmt->field = V4L2_FIELD_NONE;
+	ffmt->colorspace = V4L2_COLORSPACE_SRGB;
+	ffmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	ffmt->quantization = V4L2_QUANTIZATION_DEFAULT;
+	ffmt->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+
+	return fmt;
+}
+
+static int obcam_set_fmt(struct v4l2_subdev *sd,
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 15, 10)
+			 struct v4l2_subdev_pad_config *cfg,
+#else
+			 struct v4l2_subdev_state *state,
+#endif
+			 struct v4l2_subdev_format *fmt)
+{
+	struct obcam *priv = to_obcam(sd);
+	struct v4l2_mbus_framefmt *mf = &fmt->format;
+
+	if (fmt->pad)
+		return -EINVAL;
+
+	mutex_lock(&priv->lock);
+	priv->config.format = obcam_find_format(priv, mf,
+						&priv->config.resolution);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 15, 10)
+		*v4l2_subdev_get_try_format(sd, cfg, fmt->pad) = *mf;
+#else
+		*v4l2_subdev_state_get_format(state, fmt->pad) = *mf;
+#endif
+	} else {
+		priv->format = *mf;
+	}
+	mutex_unlock(&priv->lock);
+
+	return 0;
+}
+
+static int obcam_g_frame_interval(struct v4l2_subdev *sd,
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 118)
+				  struct v4l2_subdev_state *state,
+#endif
+				  struct v4l2_subdev_frame_interval *fi)
+{
+	struct obcam *priv = to_obcam(sd);
+
+	if (!fi)
+		return -EINVAL;
+
+	mutex_lock(&priv->lock);
+	fi->interval.numerator = 1;
+	fi->interval.denominator = priv->config.framerate;
+	mutex_unlock(&priv->lock);
+
+	return 0;
+}
+
+static u16 obcam_probe_framerate(const struct obcam_resolution *res, u16 target)
+{
+	unsigned int i;
+
+	for (i = 0; i < res->n_framerates; i++) {
+		if (target <= res->framerates[i])
+			return res->framerates[i];
+	}
+
+	return res->framerates[res->n_framerates - 1];
+}
+
+static int obcam_s_frame_interval(struct v4l2_subdev *sd,
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 15, 118)
+				  struct v4l2_subdev_state *state,
+#endif
+				  struct v4l2_subdev_frame_interval *fi)
+{
+	struct obcam *priv = to_obcam(sd);
+	u16 framerate;
+
+	if (!fi || !fi->interval.numerator)
+		return -EINVAL;
+
+	mutex_lock(&priv->lock);
+	framerate = fi->interval.denominator / fi->interval.numerator;
+	framerate = obcam_probe_framerate(priv->config.resolution, framerate);
+	priv->config.framerate = framerate;
+	fi->interval.numerator = 1;
+	fi->interval.denominator = framerate;
+	mutex_unlock(&priv->lock);
+
+	return 0;
+}
+
+static int obcam_s_stream(struct v4l2_subdev *sd, int on)
+{
+	struct obcam *priv = to_obcam(sd);
+
+	mutex_lock(&priv->lock);
+	priv->streaming = !!on;
+	mutex_unlock(&priv->lock);
+
+	dev_dbg(sd->dev, "%s stream %s\n", sd->name, on ? "on" : "off");
+
+	return 0;
+}
+
+static const struct v4l2_subdev_pad_ops obcam_pad_ops = {
+	.enum_mbus_code = obcam_enum_mbus_code,
+	.enum_frame_size = obcam_enum_frame_size,
+	.enum_frame_interval = obcam_enum_frame_interval,
+	.get_fmt = obcam_get_fmt,
+	.set_fmt = obcam_set_fmt,
+	.get_frame_interval = obcam_g_frame_interval,
+	.set_frame_interval = obcam_s_frame_interval,
+};
+
+static const struct v4l2_subdev_video_ops obcam_video_ops = {
+	.s_stream = obcam_s_stream,
+};
+
+static const struct v4l2_subdev_ops obcam_subdev_ops = {
+	.pad = &obcam_pad_ops,
+	.video = &obcam_video_ops,
+};
+
+static int obcam_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	dev_dbg(sd->dev, "%s: %s\n", __func__, sd->name);
+	return 0;
+}
+
+static int obcam_close(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	dev_dbg(sd->dev, "%s: %s\n", __func__, sd->name);
+	return 0;
+}
+
+static const struct v4l2_subdev_internal_ops obcam_internal_ops = {
+	.open = obcam_open,
+	.close = obcam_close,
+};
+
+static void obcam_select_formats(struct obcam *priv, const char *stream_type)
+{
+	if (!stream_type)
+		stream_type = "Depth";
+
+	if (!strcmp(stream_type, "RGB")) {
+		priv->formats = obcam_rgb_formats;
+		priv->n_formats = ARRAY_SIZE(obcam_rgb_formats);
+	} else if (!strcmp(stream_type, "IR_L") || !strcmp(stream_type, "IR_R") ||
+		   !strcmp(stream_type, "IR")) {
+		priv->formats = obcam_ir_formats;
+		priv->n_formats = ARRAY_SIZE(obcam_ir_formats);
+	} else {
+		priv->formats = obcam_depth_formats;
+		priv->n_formats = ARRAY_SIZE(obcam_depth_formats);
+	}
+}
+
+#if defined(NV_I2C_DRIVER_STRUCT_PROBE_WITHOUT_I2C_DEVICE_ID_ARG) /* Linux 6.3 */
+static int obcam_probe(struct i2c_client *client)
+#else
+static int obcam_probe(struct i2c_client *client, const struct i2c_device_id *id)
+#endif
+{
+	struct device *dev = &client->dev;
+	struct obcam *priv;
+	struct v4l2_subdev *sd;
+	struct media_entity *entity;
+	const char *stable_name;
+	const char *stream_type;
+	int err;
+
+	if (!IS_ENABLED(CONFIG_OF) || !dev->of_node)
+		return -EINVAL;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->client = client;
+	mutex_init(&priv->lock);
+
+	err = device_property_read_string(dev, "orbbec,stable-name",
+					  &stable_name);
+	if (!err) {
+		strscpy(priv->stable_name, stable_name,
+			sizeof(priv->stable_name));
+	} else {
+		snprintf(priv->stable_name, sizeof(priv->stable_name),
+			 "obcam %d-%04x", i2c_adapter_id(client->adapter),
+			 client->addr);
+	}
+
+	err = device_property_read_string(dev, "orbbec,stream-type",
+					  &stream_type);
+	if (err)
+		stream_type = NULL;
+
+	obcam_select_formats(priv, stream_type);
+	obcam_format_init(priv);
+
+	sd = &priv->s_data.subdev;
+	v4l2_i2c_subdev_init(sd, client, &obcam_subdev_ops);
+	sd->owner = NULL;
+	sd->internal_ops = &obcam_internal_ops;
+	sd->grp_id = client->dev.devt;
+	sd->flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	v4l2_set_subdevdata(sd, priv);
+	strscpy(sd->name, priv->stable_name, sizeof(sd->name));
+
+	priv->pad.flags = MEDIA_PAD_FL_SOURCE;
+	entity = &sd->entity;
+	entity->obj_type = MEDIA_ENTITY_TYPE_V4L2_SUBDEV;
+	entity->function = MEDIA_ENT_F_CAM_SENSOR;
+
+	err = media_entity_pads_init(entity, 1, &priv->pad);
+	if (err)
+		return err;
+
+	priv->s_data.dev = dev;
+	priv->s_data.priv = priv;
+
+	err = camera_common_initialize(&priv->s_data, OBCAM_DRIVER_NAME);
+	if (err) {
+		dev_err(dev, "Failed to initialize camera common data, %d\n",
+			err);
+		goto err_entity;
+	}
+
+	err = v4l2_async_register_subdev(sd);
+	if (err)
+		goto err_camera_common;
+
+	dev_info(dev, "%s registered as obcam thin V4L2 subdev (%s)\n",
+		 sd->name, stream_type ? stream_type : "Depth");
+
+	return 0;
+
+err_camera_common:
+	camera_common_cleanup(&priv->s_data);
+err_entity:
+	media_entity_cleanup(entity);
+
+	return err;
+}
+
+#if defined(NV_I2C_DRIVER_STRUCT_REMOVE_RETURN_TYPE_INT) /* Linux 6.1 */
+static int obcam_remove(struct i2c_client *client)
+#else
+static void obcam_remove(struct i2c_client *client)
+#endif
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct obcam *priv = sd ? to_obcam(sd) : NULL;
+
+	if (sd) {
+		camera_common_cleanup(&priv->s_data);
+		v4l2_async_unregister_subdev(sd);
+		media_entity_cleanup(&sd->entity);
+	}
+
+#if defined(NV_I2C_DRIVER_STRUCT_REMOVE_RETURN_TYPE_INT) /* Linux 6.1 */
+	return 0;
+#endif
+}
+
+static const struct i2c_device_id obcam_id[] = {
+	{ "obcam", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, obcam_id);
+
+static struct i2c_driver obcam_i2c_driver = {
+	.driver = {
+		.name = OBCAM_DRIVER_NAME,
+		.owner = THIS_MODULE,
+		.of_match_table = of_match_ptr(obcam_of_match),
+	},
+	.probe = obcam_probe,
+	.remove = obcam_remove,
+	.id_table = obcam_id,
+};
+
+module_i2c_driver(obcam_i2c_driver);
+
+MODULE_DESCRIPTION("Orbbec Camera thin V4L2 subdev driver");
+MODULE_AUTHOR("yezhenhao <yanxiao@orbbec.com>");
+MODULE_AUTHOR("chenwendong <xuanyuan@orbbec.com>");
+MODULE_LICENSE("GPL v2");
