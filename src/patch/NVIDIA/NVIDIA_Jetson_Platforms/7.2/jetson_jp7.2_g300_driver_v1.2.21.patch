+int orbbec_is_factory_calib_mode(struct orb *state)
+{
+    int ret = 0;
+    char current_mode[WORK_MODE_DESC_STR_LEN] = {0};
+
+    if (!state) {
+        pr_err("orbbec_is_factory_calib_mode: state is NULL\n");
+        return -EINVAL;
+    }
+
+    dev_dbg(&state->client->dev, "start check whether current mode is Factory Calib\n");
+
+    ret = orbbec_get_current_work_mode_desc(state, current_mode, sizeof(current_mode));
+    if (ret < 0) {
+        dev_err(&state->client->dev,
+                "failed to get current work mode desc, ret=%d\n",
+                ret);
+        return ret;
+    }
+
+    dev_dbg(&state->client->dev,
+             "compare current mode [%s] with target [Factory Calib]\n",
+             current_mode);
+
+    if (!strcmp(current_mode, "Factory Calib")) {
+        dev_info(&state->client->dev,
+                 "current mode matched Factory Calib\n");
+        return 1;
+    }
+
+    dev_info(&state->client->dev,
+             "current mode is not Factory Calib\n");
+
+    return 0;
+}
