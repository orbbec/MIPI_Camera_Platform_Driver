+    GMSL_STATUS_SER_IR_R_PIPE_OVERFLOW               = (1ULL << 26),   // 串行器IR_R PIPE带宽溢出：0=正常，1=溢出
+    GMSL_STATUS_SER_IR_R_PIPE_DRIFT_ERR              = (1ULL << 27),   // 串行器IR_R PIPE PCLK漂移错误：0=正常，1=错误
+    GMSL_STATUS_DESER_IR_R_PIPE_VID_UNLOCK           = (1ULL << 28),   // 解串器IR_R视频PIPE锁定：0=已锁定，1=未锁定
+    GMSL_STATUS_DESER_IR_R_PIPE_PKT_UNDETECTED       = (1ULL << 29),   // 解串器IR_R PIPE数据包检测：0=检测到充足的数据包，1=未检测到充足的数据包
+    GMSL_STATUS_DESER_IR_R_PIPE_LINE_CRC_ERR         = (1ULL << 30),   // 解串器IR_R PIPE行CRC_ERR错误：0=无错误，1=存在错误
+    GMSL_STATUS_DESER_IR_R_PIPE_LINE_MEM_ERR         = (1ULL << 31),   // 解串器IR_R PIPE行内存错误：0=无错误，1=存在错误
+	GMSL_STATUS_MIPI_PLL_UNLOCKED             		 = (1ULL << 32),   // MIPI CSI PLL锁定：0=已锁定，1=未锁定
+    GMSL_STATUS_MIPI_FIFO_OVERFLOW          		 = (1ULL << 33),   // MIPI FIFO溢出：0=无溢出，1=溢出
+    GMSL_STATUS_MIPI_FIFO_UNDERFLOW         		 = (1ULL << 34),   // MIPI FIFO下溢：0=无下溢，1=下溢
+	GMSL_STATUS_LINK_DEC_ERR                		 = (1ULL << 35),   // Link解码错误：0=无错误，1=存在错误
+    GMSL_STATUS_LINK_EOM_ERR_FLAG              		 = (1ULL << 36),   // Link EOM眼图监测器错误：0=无错误，1=存在错误
+    GMSL_STATUS_DESER_ERRB_ASSERTED         		 = (1ULL << 37),   // 解串器ERRB置位：0=未置位，1=已置位
