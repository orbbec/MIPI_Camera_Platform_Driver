+/* Write data to orbbec camera via I2C (no register address)
+ * state: pointer to global orb state struct
+ * data: data to write
+ * length: write length
+ * Return: -EINVAL/-EIO on error, 0 on success
+ */
+static int sensor_write_data(struct orb *state, void *data, u16 length)
+{
+    int ret, retry;
+
+    if (!state || !data || length == 0 || !state->deser_ops || !state->deser_ops->write_sensor) {
+        pr_err("sensor_write_data: invalid parameters\n");
+        return -EINVAL;
+    }
+
+    for (retry = 0; retry < ORBBEC_I2C_RETRY_CNT; retry++) {
+        ret = state->deser_ops->write_sensor(state->dser_dev, state->dser_link, data, length);
+        if (ret == 0) {
+            dev_dbg(&state->client->dev, "sensor_write_data success, length=%d\n", length);
+            return 0;
+        }
+        dev_warn(&state->client->dev, "sensor_write_data failed, retry=%d, ret=%d\n", retry, ret);
+        msleep(ORBBEC_I2C_RETRY_DELAY);
+    }
+    dev_err(&state->client->dev, "sensor_write_data all retry fail, ret=%d\n", ret);
+    return ret;
+}
+
+/* Read data from orbbec camera via I2C (no register address)
+ * state: pointer to global orb state struct
+ * data: buffer to store read data
+ * length: read length
+ * Return: -EINVAL/-EIO on error, 0 on success
+ */
+static int sensor_read_data(struct orb *state, void *data, u16 length)
+{
+    int ret, retry;
+
+    if (!state || !data || length == 0 || !state->deser_ops || !state->deser_ops->read_sensor) {
+        dev_err(&state->client->dev, "sensor_read_data: invalid parameters\n");
+        return -EINVAL;
+    }
+
+    for (retry = 0; retry < ORBBEC_I2C_RETRY_CNT; retry++) {
+        ret = state->deser_ops->read_sensor(state->dser_dev, state->dser_link, data, length);
+        if (ret == 0) {
+            dev_dbg(&state->client->dev, "sensor_read_data success, length=%d\n", length);
+            return 0;
+        }
+        dev_warn(&state->client->dev, "sensor_read_data failed, retry=%d, ret=%d\n", retry, ret);
+        msleep(ORBBEC_I2C_RETRY_DELAY);
+    }
+    dev_err(&state->client->dev, "sensor_read_data all retry fail, ret=%d\n", ret);
+    return ret;
+}
