+int orbbec_get_frame_profile_len(struct orb *state, void * data)
+{
+    int ret = 0, i = 0;
+    u16 cmd_index;
+    struct orbbec_cmd *cmd = &state->orbbec_cmd_buffer;
+
+    /* Clear the buffer before use */
+    memset(cmd, 0, sizeof(struct orbbec_cmd));
+
+    cmd->header.len = G2R_GET_FRAME_PROFILE_LEN_CMD_LEN;
+    cmd->header.code = G2R_GET_FRAME_PROFILE_LEN_CORE;
+    cmd->header.index = orb_cmd_index++;
+    cmd->_data[0] = 0xc3;
+    cmd->_data[1] = 0x0f;
+    cmd->_data[2] = 0x00;
+    cmd->_data[3] = 0x00;
+
+    ret = sensor_write_data(state, cmd, G2R_GET_FRAME_PROFILE_LEN_CMD_LEN);
+    if(ret < 0) {
+        dev_err(&state->client->dev, "i2c write get_frame_profile_len cmd err\n");
+        return ret;
+    }
+    cmd_index = cmd->header.index;
+
+    usleep_range(500, 800);
+    for(i = 0; i <= ORBBEC_I2C_RETRY_CNT; i++) {
+        usleep_range(100,120);
+        ret = sensor_read_data(state, cmd, G2R_GET_FRAME_PROFILE_LEN_LEN);
+        if(ret < 0) {
+            dev_err(&state->client->dev, "i2c write get_frame_profile_len data err\n");
+            goto err;
+        }
+        if(cmd->header.len == 0 && cmd->header.code == 0 && cmd->header.index == 0) {
+            dev_warn(&state->client->dev, "retry get_frame_profile_len\n");
+            continue;
+        }
+        else if(cmd->header.len != G2R_GET_FRAME_PROFILE_LEN_LEN || cmd->header.code != G2R_GET_FRAME_PROFILE_LEN_CORE || cmd->header.index != cmd_index) {
+            cmd->header.len = G2R_GET_FRAME_PROFILE_LEN_LEN;
+            cmd->_data[0] = 0;
+            cmd->_data[1] = 0;
+            dev_err(&state->client->dev, " get_frame_profile_len data err\n");
+            break;
+        } else {
+            break;
+        }
+    }
+err:
+    memcpy(data, cmd->msg_body.data, 4);
+    return ret;
+}
