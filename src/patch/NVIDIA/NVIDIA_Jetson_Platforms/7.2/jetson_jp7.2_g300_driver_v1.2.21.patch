+/*
+ Programming Steps - Video Data Path
+Configuring the forward video path from the GMSL2 quad deserializer consists of four basic programming steps:
+ 1. Link Initialization
+ 2. Video Pipe Selection
+ 3. Video Pipe to MIPI Controller Mapping
+ 4. MIPI PHY Settings
+*/
+
+/*-----------------------------------------------------------------------------------------------
+ * 4. MIPI PHY Settings
+ *----------------------------------------------------------------------------------------------*/
+#define MAX9296_DST_CSI_MODE_ADDR 0x330 //MIPI PHY Mode Select Register: 2x4 mode, 1x4 mode, 4x2 mode
+
+#define MAX9296_PWDN_PHYS_ADDR   0x332  //MIPI PHY Enable Register: MIPI PHY 0~3, 0 = PHY in standby, 1 = PHY enabled
+#define ALLPHYS_NOSTDBY          0xF0 
+
+#define MAX9296_LANE_MAP1_ADDR   0x333 //MIPI PHY 0&1 Lane Mapping Register
+#define MAX9296_LANE_MAP2_ADDR   0x334 //MIPI PHY 3&2 Lane Mapping Register
+#define MAX9296_LANE_POLA1_ADDR  0x335 //MIPI PHY 0&1 Lane Polarity Register
+#define MAX9296_LANE_POLA2_ADDR  0x336 //MIPI PHY 3&2 Lane Polarity Register
+
+#define MAX9296_LANE_CTRL0_ADDR  0x40A //MIPI PHY 0 Lane Count / C-PHY enable Register
+#define MAX9296_LANE_CTRL1_ADDR  0x44A //MIPI PHY 1 Lane Count / C-PHY enable Register
+#define MAX9296_LANE_CTRL2_ADDR  0x48A //MIPI PHY 2 Lane Count / C-PHY enable Register
+#define MAX9296_LANE_CTRL3_ADDR  0x4CA //MIPI PHY 3 Lane Count / C-PHY enable Register
+
+#define MAX9296_PHY0_CLK_ADDR 	 0x31D //MIPI PHY 0 DPLL Freq Register
+#define MAX9296_PHY1_CLK_ADDR 	 0x320 //MIPI PHY 1 DPLL Freq Register
+#define MAX9296_PHY2_CLK_ADDR 	 0x323 //MIPI PHY 2 DPLL Freq Register
+#define MAX9296_PHY3_CLK_ADDR 	 0x326 //MIPI PHY 2 DPLL Freq Register
+
+// #define MAX9296_CSI_OUT_EN      0x40B //CSI_OUT_EN: CSI output enabled, en:0x2, dis:0x0
+
+#define MAX9296_LANE_CTRL_MAP(num_lanes) \
+    (((num_lanes - 1) << 6))
+
+/*-----------------------------------------------------------------------------------------------
+ * 3. Video Pipe to MIPI Controller Mapping
+ *----------------------------------------------------------------------------------------------*/
+#define MAX9296_TX11_PIPE_X_EN_ADDR   0x40B //Mapping Enable Low Byte, 0~7
+#define MAX9296_TX11_PIPE_X_EN_H_ADDR 0x40C //Mapping Enable High Byte, 8~15
+
+#define MAX9296_PIPE_X_SRC_0_MAP_ADDR 0x40D //MAP_SRC_0 Register: VC+DT
+#define MAX9296_PIPE_X_DST_0_MAP_ADDR 0x40E //MAP_DES_0 Register: VC+DT
+#define MAX9296_PIPE_X_SRC_1_MAP_ADDR 0x40F //MAP_SRC_1 Register: VC+DT
+#define MAX9296_PIPE_X_DST_1_MAP_ADDR 0x410 //MAP_DES_1 Register: VC+DT
+#define MAX9296_PIPE_X_SRC_2_MAP_ADDR 0x411 //MAP_SRC_2 Register: VC+DT
+#define MAX9296_PIPE_X_DST_2_MAP_ADDR 0x412 //MAP_DES_2 Register: VC+DT
+#define MAX9296_PIPE_X_SRC_3_MAP_ADDR 0x413 //MAP_SRC_3 Register: VC+DT
+#define MAX9296_PIPE_X_DST_3_MAP_ADDR 0x414 //MAP_DES_3 Register: VC+DT
+
+#define MAX9296_TX45_PIPE_X_DST_CTRL_ADDR  0x42D //MAP Destination Controller Register: 0~3
+#define MAX9296_TX45_PIPE_X_DST_CTRL2_ADDR 0x42E //MAP Destination Controller Register: 4~7
+
+#define MAX9296_BACKTOP1_ADDR 			   0x308 //bit[4:7]CSIPLL_LOCK
+#define MAX9296_CSIPLL_LOCK_BIT 		   (3 << 5) //bit[4:7]CSIPLL_LOCK
+
+#define MAX9296_MIPI_PHY9_ADDR 			   0x339 //bit[0] overflow error
+#define MAX9296_MIPI_PHY10_ADDR 		   0x33A //bit[0] underflow error
+#define MAX9296_MIPI_PHY_STATUS_BIT  	   (1 << 0)
+
+#define MAX9296_DEC_ERR_FLG_ADDR 		   0x1B //bit[0:1] LinkA/B decoder error flag
+#define MAX9296_DEC_ERR_FLG_BIT 		   (1 << 0) //bit[0] LinkA decoder error flag
+#define MAX9296_DEC_ERR_A_ADDR 		   	   0x22 //bit[0:7] decoder error detect
+#define MAX9296_DEC_ERR_B_ADDR 		   	   0x23 //bit[0:7] decoder error detect
+
+#define MAX9296_INTR5_FLG_ADDR 		   	   0x1D //bit[0] interrupt 5 flag
+#define MAX9296_LINKA_EOM_ERR_FLG_BIT 	   (1 << 6) //bit[6] EOM error flag
+//--------------------------------------------------------------------
+// others
+#define MAX9296_PIPE_X_ST_SEL_ADDR  0x50 //RX packets with selected stream ID, add b7: RX_CRC_EN
+
+#define MAX9296_REG1_ADDR  0x01   //REG 1
+#define MAX9296_CTRL0_ADDR 0x10   //get link status
+#define MAX9296_CTRL2_ADDR 0x12
+#define CTRL0_RESET_ALL     0x80  //b[7]: 1->RESET_ALL, Chip reset
+#define CTRL0_RESET_LINK    0x40  //b[6]: reset link
+#define CTRL0_RESET_ONESHOT 0x20  //b[5]: reset oneshot, keep register
+#define CTRL0_LINK_SPLITTER_MODE 0x3 //Enable plitter mode
+#define CTRL0_REG_ENABLE 	0x4 //Enable VDD LDO regulator
+
+#define MAX9296_CTRL3_ADDR 0x13 	//get link status
+#define CTRL3_LINK_LOCKED  0x08 	//b[3], GMSL2 link locked
+#define CTRL3_ERRB_ASSERTED  0x04 	//b[2], GMSL2 ERRB pin asserted
+
+#define MAX9296_LINK_RESET_ADDR 0x10
+/*-----------------------------------------------------------------------------------------------
+ * data defines
+ *----------------------------------------------------------------------------------------------*/
+/* MIPI PHY Mode Select */
+#define MAX9296_CSI_MODE_4X2 0x1  //4x2lanes
+#define MAX9296_CSI_MODE_1X4 0x2
+#define MAX9296_CSI_MODE_2X4 0x4  //2x4lanes
+
+//----------------------------------------------------------
+#define MAX9296_MAX_PIPES	4
+#define MAX9296_MAX_LINKS   2
+
+#define MAX9295D_MAX_PIPES	4
+
+#define SER_PIPE_PCLK_DET_BIT  		    (1<<7)
+#define SER_PIPE_DRIFT_ERR_BIT  	    (1<<6)
+#define SER_PIPE_OVERFLOW_BIT  		    (1<<5)
+
+#define DESER_PIPE_VID_LOCK_BIT  		(1<<6)
+#define DESER_PIPE_PKT_DET_BIT  	    (1<<5)
+
+#define DESER_PIPE_LINE_CRC_BIT  		(1<<7)
+
+#define MAX9296_DISABLE_SOFTWARE_OVERRIDE	0x20
+//----------------------------------------------------------
+#define SERI_DEFAULT_I2C_ADDRESS    0x40
+
+//----------------------------------------------------------
+#define TO_SERI_ADDR(A)	(priv->seri_start_addr + (A))
+#define TO_SNR_ADDR(A)	(priv->snr_proxy_addr + (A))
+
+static const u16 g_ser_pipe_status_addr_tab[MAX9295D_MAX_PIPES] = {0x102, 0x10A, 0x112, 0x11A};
+static const u16 g_deser_pipe_status_addr_tab[MAX9296_MAX_PIPES] = {0x108, 0x11A, 0x12C, 0x13E};
+static const u16 g_deser_pipe_crc_status_addr_tab[MAX9296_MAX_PIPES] = {0x100, 0x112, 0x124, 0x136};
+
+struct cam_status_bits {
+    // SER (transmitter) status bits
+    __u64 pclk_undetected;
+    __u64 drift_err;
+    __u64 overflow;
+    // DESER (receiver) status bits
+    __u64 vid_unlock;
+    __u64 pkt_undetected;
+    // CRC status bits
+    __u64 line_crc_err;
+};
+
+static const struct cam_status_bits g_cam_status_map[ORB_CAM_TYPE_COUNT] = {
+    [ORB_CAM_DEPTH] = {
+        .pclk_undetected = GMSL_STATUS_SER_DEPTH_PIPE_PCLK_UNDETECTED,
+        .drift_err       = GMSL_STATUS_SER_DEPTH_PIPE_DRIFT_ERR,
+        .overflow        = GMSL_STATUS_SER_DEPTH_PIPE_OVERFLOW,
+        .vid_unlock      = GMSL_STATUS_DESER_DEPTH_PIPE_VID_UNLOCK,
+        .pkt_undetected  = GMSL_STATUS_DESER_DEPTH_PIPE_PKT_UNDETECTED,
+        .line_crc_err    = GMSL_STATUS_DESER_DEPTH_PIPE_LINE_CRC_ERR,
+    },
+    [ORB_CAM_COLOR] = {
+        .pclk_undetected = GMSL_STATUS_SER_COLOR_PIPE_PCLK_UNDETECTED,
+        .drift_err       = GMSL_STATUS_SER_COLOR_PIPE_DRIFT_ERR,
+        .overflow        = GMSL_STATUS_SER_COLOR_PIPE_OVERFLOW,
+        .vid_unlock      = GMSL_STATUS_DESER_COLOR_PIPE_VID_UNLOCK,
+        .pkt_undetected  = GMSL_STATUS_DESER_COLOR_PIPE_PKT_UNDETECTED,
+        .line_crc_err    = GMSL_STATUS_DESER_COLOR_PIPE_LINE_CRC_ERR,
+    },
+    [ORB_CAM_IR_L] = {
+        .pclk_undetected = GMSL_STATUS_SER_IR_L_PIPE_PCLK_UNDETECTED,
+        .drift_err       = GMSL_STATUS_SER_IR_L_PIPE_DRIFT_ERR,
+        .overflow        = GMSL_STATUS_SER_IR_L_PIPE_OVERFLOW,
+        .vid_unlock      = GMSL_STATUS_DESER_IR_L_PIPE_VID_UNLOCK,
+        .pkt_undetected  = GMSL_STATUS_DESER_IR_L_PIPE_PKT_UNDETECTED,
+        .line_crc_err    = GMSL_STATUS_DESER_IR_L_PIPE_LINE_CRC_ERR,
+    },
+    [ORB_CAM_IR_R] = {
+        .pclk_undetected = GMSL_STATUS_SER_IR_R_PIPE_PCLK_UNDETECTED,
+        .drift_err       = GMSL_STATUS_SER_IR_R_PIPE_DRIFT_ERR,
+        .overflow        = GMSL_STATUS_SER_IR_R_PIPE_OVERFLOW,
+        .vid_unlock      = GMSL_STATUS_DESER_IR_R_PIPE_VID_UNLOCK,
+        .pkt_undetected  = GMSL_STATUS_DESER_IR_R_PIPE_PKT_UNDETECTED,
+        .line_crc_err    = GMSL_STATUS_DESER_IR_R_PIPE_LINE_CRC_ERR,
+    },
+};
+
+//--------------------------------------------------------------------------------------
+struct index_reg_8 {
+    u8 source;
+    u16 addr;
+    u8 val;
+};
+
+struct max9296a {
+    struct mutex lock;
+    struct i2c_client *i2c_client;
+    struct regmap *regmap;
+    u8 csi_mode;
+    u8 num_lanes;
+    u8 mipi_rate;
+    u8 links_map;
+    u8 links_init_flag;
+    u8 pipes_map;
+    u8 index;
+    u8 deser_addr; //deser address
+    u8 seri_start_addr; //serializer start address
+    u8 snr_proxy_addr;  // sensor proxy address
+    u8 snr_real_addr;   // sensor real address
+    u8 link_mask;   // sensor real address
+    int reset_gpio;
+    int fsync_mfp_x;
+    int pps_mfp_x;
+    int vdd_supply_1v2;
+    int splitter_enabled;
+};
+
+//--------------------------------------------------------------------------------------
+static int __max9296a_reg_write(struct max9296a *priv, u16 addr, u8 val)
+{
+    int err, retry;
+
+    for (retry = 0; retry < ORBBEC_I2C_RETRY_CNT; retry++) {
+        err = regmap_write(priv->regmap, addr, val);
+        if (err == 0) {
+            dev_dbg(&priv->i2c_client->dev, "[dser 0x%02x] i2c wr: 0x%04x = 0x%02x\n", priv->i2c_client->addr, addr, val);
+            usleep_range(100, 150);
+            return 0;
+        }
+		dev_err(&priv->i2c_client->dev, "max9296 write reg 0x%04x = %02x fail, err=%d, retry=%d\n", addr, val, err, retry);
+        usleep_range(MAX9296A_RETRY_DELAY_US, MAX9296A_RETRY_DELAY_US + 50);
+    }
+    dev_err(&priv->i2c_client->dev, "max9296 write reg 0x%04x = %02x fail, err=%d\n", addr, val, err);
+    return err;
+}
+
+static int __max9296a_reg_read(struct max9296a *priv, u16 addr, u8 *val)
+{
+    unsigned int value;
+    int err, retry;
+
+    for (retry = 0; retry < ORBBEC_I2C_RETRY_CNT; retry++) {
+        err = regmap_read(priv->regmap, addr, &value);
+        if (err == 0) {
+            *val = value & 0xff;
+            dev_dbg(&priv->i2c_client->dev, "[dser 0x%02x] i2c rd: 0x%04x = 0x%02x\n", priv->i2c_client->addr, addr, *val);
+            usleep_range(100, 150);
+            return 0;
+        }
+		dev_err(&priv->i2c_client->dev, "max9296 read reg 0x%04x fail, err=%d, retry=%d\n", addr, err, retry);
+        usleep_range(MAX9296A_RETRY_DELAY_US, MAX9296A_RETRY_DELAY_US + 50);
+    }
+    *val = 0;
+    dev_err(&priv->i2c_client->dev, "max9296 read reg 0x%04x fail, err=%d\n", addr, err);
+    return err;
+}
