+    if(priv->is_port_b_connected == 0 && priv->csi_mode == MAX96712_CSI_MODE_2X4 && dst_vc_id >= CSI_VC_MAX_NUMS) {
+        dst_vc_id = dst_vc_id - CSI_VC_MAX_NUMS; //One MIPI CSI, only 4 VC IDs (VC0–VC3).
+    }
+
+    mutex_lock(&priv->lock);
+
+#if 0
+    for (int i = 0; i < MAX96712_MAX_PIPES; i++) {
+        if(!(priv->pipes_map & (1<<i))) {
+            priv->pipes_map |= (1<<i);
+            pipe_id = i;
+            break;
+        }
