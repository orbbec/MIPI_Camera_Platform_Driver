+int max96712_reset_dev(struct device *dev, u8 link_id)
+{
+    struct max96712 *priv = dev_get_drvdata(dev);
+    int ret, link_state;
+    // if links init no finish, can't reset
+    if (priv->links_init_flag) {
+        dev_err(dev, "links init no finish, can't reset max96712\n");
+        return 0;
+    }
+
+    max96712_get_link_state(dev, link_id, &link_state);
+    if(link_state == 0) {
+        dev_err(dev, "link %d is not connected, no need reset max96712\n", link_id);
+        return -EINVAL;
+    }
+
+    max96712_power_off(dev);
+    msleep(600);
+    ret = max96712_power_on(dev);
+    if (ret) {
+        dev_err(dev, "power on failed, %d\n", ret);
+        return ret;
+    }
+    msleep(200);
+
+    /* Serializer i2c address trans */
+    ret = max96712_seri_i2c_addr_trans(dev);
+    if(ret) {
+        dev_err(dev, "Serializer i2c address change failed, %d\n", ret);
+        return ret;
+    }
+
+    ret = max96712_init_settings(dev);
+    if(ret) {
+        dev_err(dev, "max96712 init settings failed, %d\n", ret);
+        return ret;
+    }
+
+    ret = max96712_set_snr_proxy_addr(dev);
+    if(ret) {
+        dev_err(dev, "max96712 set_snr_proxy_addr failed, %d\n", ret);
+        return ret;
+    }
+
+    ret = max96712_set_all_links_sensor_off(dev);
+    if(ret){
+        dev_err(dev, "max96712_set_all_links_sensor_off failed, %d\n", ret);
+        return ret;
+    }
+    /*set daymode by fault*/
+    dev_info(dev, "%s: success\n", __func__);
+
+    return ret;
+}
+EXPORT_SYMBOL(max96712_reset_dev);
