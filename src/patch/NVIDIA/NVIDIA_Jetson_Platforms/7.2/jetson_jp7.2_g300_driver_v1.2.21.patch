+int max9296a_reset_dev(struct device *dev, u8 link_id)
+{
+    struct max9296a *priv = dev_get_drvdata(dev);
+    int ret = 0;
+
+    // if links init no finish, can't reset
+    if (priv->links_init_flag) {
+        dev_err(dev, "links init no finish, can't reset max9296a\n");
+        return 0;
+    }
+    else if ( priv->links_map && (link_id == ORB_LINKB) && ((priv->links_map & (1<<link_id)) == 0)) {
+        dev_err(dev, "link0 is init, link%d can't reset max9296a\n", link_id);
+        return 0;
+    }
+
+    max9296a_power_off(dev);
+    msleep_range(600);
+    ret = max9296a_power_on(dev);
+    if (ret) {
+        dev_err(dev, "power on failed, %d\n", ret);
+        return ret;
+    }
+    msleep_range(200);
+
+    if (of_get_property(dev->of_node, "is-fg96-2ch", NULL)) {
+        //Enable POC
+        max9296a_write_reg(dev, 0x0005, 0x80);
+        max9296a_write_reg(dev, 0x02BC, 0x80); //Enable MFP4 Output low
+        max9296a_write_reg(dev, 0x02BD, 0x84); //Enable MFP4 Output Pulldown
+    }
+
+    if (of_get_property(dev->of_node, "is-fg96-8ch-v2.1", NULL)) {
+        //Enable POC
+        max9296a_write_reg(dev, 0x0005, 0x80);
+        max9296a_write_reg(dev, 0x02BC, 0x90); //Enable MFP4 Output hight
+    }
+
+    /* Serializer i2c address trans */
+    ret = max9296a_seri_i2c_addr_trans(dev);
+    if(ret) {
+        dev_err(dev, "Serializer i2c address change failed, %d\n", ret);
+        return ret;
+    }
+
+    ret = max9296a_init_settings(dev);
+    if(ret) {
+        dev_err(dev, "max9296a init settings failed, %d\n", ret);
+        return ret;
+    }
+    ret = max9296a_set_snr_proxy_addr(dev);
+    if(ret) {
+        dev_err(dev, "max9296a set_snr_proxy_addr failed, %d\n", ret);
+        return ret;
+    }
+    ret = max9296a_set_all_links_sensor_off(dev);
+    if(ret) {
+        dev_err(dev, "max9296a_set_all_links_sensor_off failed, %d\n", ret);
+        return ret;
+    }
+    /*set daymode by fault*/
+    dev_info(dev, "%s: success\n", __func__);
+
+    return ret;
+}
+EXPORT_SYMBOL(max9296a_reset_dev);
+
+int max9296a_get_link_state(struct device *dev, u8 link_id, int *value)
+{
+    int ret;
+    u8 val = 0;
+
+    ret = max9296a_read_reg(dev, MAX9296_CTRL3_ADDR, &val);
+    if (ret)
+        dev_err(dev, "%s:failed\n", __func__);
+    *value = (val & CTRL3_LINK_LOCKED) ? 1 : 0; //b[3]: gmsl2  link locked, for linkA & B
+
+    dev_info(dev, "max9296a register 0x%04x= 0x%02x\n", MAX9296_CTRL3_ADDR, val);
+
+    return ret;
+}
+EXPORT_SYMBOL(max9296a_get_link_state);
