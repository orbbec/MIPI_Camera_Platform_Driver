+static void vi5_channel_release_requests(struct tegra_channel *chan,
+	unsigned int vi_port)
+{
+	struct tegra_vi_channel *vi_chan = chan->tegra_vi_channel[vi_port];
+
+	if (chan->request[vi_port] == NULL)
+		return;
+
+	if (!chan->request_dev[vi_port] || !chan->request_size[vi_port]) {
+		if (IS_ERR_OR_NULL(vi_chan)) {
+			dev_err(&chan->video->dev,
+				"capture request release missing DMA metadata on port %u\n",
+				vi_port);
+			return;
+		}
+
+		chan->request_dev[vi_port] = vi_chan->rtcpu_dev;
+		chan->request_size[vi_port] =
+			chan->capture_queue_depth * sizeof(struct capture_descriptor);
+	}
+
+	if (!IS_ERR_OR_NULL(vi_chan))
+		vi_chan->capture_data->requests.va = NULL;
+
+	dma_free_coherent(chan->request_dev[vi_port],
+		chan->request_size[vi_port], chan->request[vi_port],
+		chan->request_iova[vi_port]);
+	chan->request[vi_port] = NULL;
+	chan->request_iova[vi_port] = 0;
+	chan->request_dev[vi_port] = NULL;
+	chan->request_size[vi_port] = 0;
+}
