+static DEFINE_MUTEX(serdes_lock__);
+
+//---------------------------------------------------------------------------------
+static int orb_is_link(struct orb *state)
+{
+    u8 link_sta = state->deser_ops->get_link_map(state->dser_dev);
+    return ((0x1<<state->dser_link) & link_sta) ? 1 : 0;
+}
+
+static int orb_setup_pipeline(struct orb *state, u8 data_type1_src, u8 data_type1_dst, u8 data_type2,
+    s16 dser_pipe_id, u8 src_vc_id, u8 dst_vc_id)
+{
+    int ret = 0;
+    u8 pipe_lock = 0;
+    u8 seri_pipe_id = dst_vc_id; // We explicitly set seri_pipe_id = dst_vc_id
+
+    dev_info(&state->client->dev, 
+            "set pipe, port:%d, pipe:%d, dt1_src: 0x%x, dt1_dst: 0x%x, dt2: 0x%x, src_vc: %u, dst_vc: %u\n",
+            state->dser_link, dser_pipe_id, data_type1_src, data_type1_dst, data_type2, src_vc_id, dst_vc_id);
+
+    ret |= max9295d_set_pipe(state, state->dser_link, seri_pipe_id, data_type1_src, data_type2, src_vc_id);
+    ret |= state->deser_ops->set_pipe(state->dser_dev, state->dser_link, dser_pipe_id, data_type1_src, data_type1_dst, data_type2, src_vc_id, dst_vc_id);
+    // ret |= max9295d_pipe_en(state, dst_vc_id, 1);
+
+    msleep(200);
+    pipe_lock = state->deser_ops->check_pipe_lock(state->dser_dev);
+    dev_info(&state->client->dev, "%s pipe lock: 0x%x\n", __func__, pipe_lock);
+
+    if (ret)
+        dev_info(&state->client->dev, "failed to setup pipe\n");
+
+    return ret;
+}
+
+static int orb_gmsl_serdes_setup(struct orb *state)
+{
+    struct device *dev;
+    int err = 0, i = 0;
+    u8 link_init_flag = 0, link = 0;
+
+    if (!state || !state->dser_dev || !state->client)
+        return -EINVAL;
+
+    link_init_flag = state->deser_ops->get_link_init_flag(state->dser_dev);
+    if(link_init_flag == 0)
+        return err;
+
+    dev = &state->client->dev;
+    dev_info(dev, "%s: start\n", __func__);
+    mutex_lock(&serdes_lock__);
+
+    link = state->deser_ops->get_link_map(state->dser_dev);
+    
+    for (i = 0; i < state->max_link_num; i++) { //link A~D
+        if(link & (1<<i)) {
+            state->deser_ops->set_link_init_flag(state->dser_dev, i);
+            err = max9295d_init_settings(state, i); //power off
+            if(err) {
+                dev_err(dev, "max9295d_init_settings : link %d failed \n", i);
+                continue;
+                //break;
+            }
+        }
+    }
+      
+    state->deser_ops->init_tx_gpio(state->dser_dev);
+
+    for (i = 0; i < state->max_link_num; i++) { //link A~D
+        if(link & (1<<i)) {
+            err = max9295d_set_orbbec_on(state, i); //power off
+            if(err) {
+                dev_err(dev, "max9295d_set_orbbec_on : link %d failed \n", i);
+                continue;
+                //break;
+            }
+        }
+    }
+    dev_info(dev, "delay 5s wait for the G300 to power on and stabilize. \n");
+    msleep_range(5000); //305g need 5s
+
+    dev_info(dev, "%s success\n", __func__);
+
+    mutex_unlock(&serdes_lock__);
+    return err;
+}
+//---------------------------------------------------------------------------------
+
+int orbbec_reset_device_link(struct orb *state, s32 value)
+{
+    int ret = 0;
+    struct i2c_client *c = state->client;
+    u8 link_init_flag = 0, link = 0;
+
+    if(!state->dser_dev)
+        return -EINVAL;
+
+    mutex_lock(&serdes_lock__);
+
+    if(state->cam_type == ORB_CAM_DEPTH) {
+
+        ret = state->deser_ops->reset_dev(state->dser_dev, state->dser_link);
+        if (ret) {
+            dev_err(&c->dev, "%s, failed to reset Deser chip settings\n", __func__);
+            goto err;
+        }
+        /*
+        ret = orb_gmsl_serdes_setup(state);
+        if (ret) {
+            dev_err(&c->dev, "orbbec gmsl serdes setup failed, %d\n", ret);
+            goto err;
+        }
+        */
+        
+        link_init_flag = state->deser_ops->get_link_init_flag(state->dser_dev);
+        if(link_init_flag == 0){
+            dev_info(&c->dev, "gmsl connect err, link_init_flag: 0x%x\n", link_init_flag);
+            ret = -ENODEV;
+            goto err;
+        } 
+        
+        link = state->deser_ops->get_link_map(state->dser_dev);
+        if(link & (1 << state->dser_link)) {
+            state->deser_ops->set_link_init_flag(state->dser_dev, state->dser_link);
+            ret = max9295d_init_settings(state, state->dser_link); //power off
+            if(ret) {
+                dev_err(&c->dev, "max9295d_init_settings : link %d failed \n", state->dser_link);
+                goto err;
+            }
+        }else{
+            dev_info(&c->dev, "gmsl connect err, link %d not found\n", state->dser_link);
+            ret = -ENODEV;
+            goto err;
+        }
+
+        link_init_flag = state->deser_ops->get_link_init_flag(state->dser_dev);
+        if(link_init_flag == 0)   
+            state->deser_ops->init_tx_gpio(state->dser_dev);
+        
+        if(link & (1<<state->dser_link)) {
+            ret = max9295d_set_orbbec_on(state, state->dser_link); //power off
+            if(ret) {
+                dev_err(&c->dev, "max9295d_set_orbbec_on : link %d failed \n", state->dser_link);
+                goto err;
+            }
+        }
+
+        dev_info(&c->dev, "delay 5s wait for the G300 to power on and stabilize. \n");
+        msleep_range(5000); //305g need 5s
+
+        ret = orbbec_get_deviceinfo(state, &state->device_info.vid, &state->device_info.pid, &state->device_info.sn, &state->device_info.asic_sn);
+        if(ret) {
+            dev_err(&c->dev, "orbbec_get_deviceinfo failed \n");
+        }
+        dev_info(&c->dev, "Camera VID 0x%04x\n", state->device_info.vid);
+        dev_info(&c->dev, "Camera PID 0x%04x\n", state->device_info.pid);
+        dev_info(&c->dev, "Camera SN :%s\n", state->device_info.sn);
+
+        if(GEMINI_305G_SERIES_PID(state->device_info.pid)) {
+            //Pipeline X&Y&Z&U from Port A ，NO PIPE from Port B
+            max9295d_set_pipe_from(state, state->dser_link, SERIALIZER_PIPE_X_SELECT | SERIALIZER_PIPE_Y_SELECT | SERIALIZER_PIPE_Z_SELECT | SERIALIZER_PIPE_U_SELECT, SERIALIZER_PIPE_NO_SELECT);
+        }
+
+        dev_info(&c->dev, "%s success\n", __func__);
+    }
+err:
+    mutex_unlock(&serdes_lock__);
+    return ret;
+}
