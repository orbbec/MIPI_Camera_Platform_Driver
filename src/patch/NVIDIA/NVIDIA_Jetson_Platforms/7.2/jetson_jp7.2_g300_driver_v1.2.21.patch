+static int orbbec_get_current_work_mode_desc(struct orb *state, char *desc, size_t desc_size)
+{
+    int ret = 0;
+    u16 res_code = 0;
+    u16 version = 0;
+    struct orbbec_cmd *cmd = &state->orbbec_cmd_buffer;
+    orbbec_work_mode_desc mode;
+
+    if (!state || !desc || desc_size == 0)
+        return -EINVAL;
+
+    memset(cmd, 0, sizeof(struct orbbec_cmd));
+    memset(&mode, 0, sizeof(mode));
+
+    dev_dbg(&state->client->dev, "start get current work mode desc\n");
+
+    cmd->header.len = G2R_GET_PROPERTY_CMD_LEN;
+    cmd->header.code = G2R_GET_CUR_WORK_MODE_CODE;
+    cmd->header.index = orb_cmd_index++;
+
+    /* dataid = 1043, little endian */
+    cmd->_data[0] = (u8)(G2R_GET_CUR_WORK_MODE_PRO_ID & 0xFF);
+    cmd->_data[1] = (u8)((G2R_GET_CUR_WORK_MODE_PRO_ID >> 8) & 0xFF);
+    cmd->_data[2] = (u8)((G2R_GET_CUR_WORK_MODE_PRO_ID >> 16) & 0xFF);
+    cmd->_data[3] = (u8)((G2R_GET_CUR_WORK_MODE_PRO_ID >> 24) & 0xFF);
+
+    dev_dbg(&state->client->dev,
+            "send get current work mode cmd: len=%u code=%u index=%u dataid=0x%08x\n",
+            cmd->header.len, cmd->header.code, cmd->header.index,
+            G2R_GET_CUR_WORK_MODE_PRO_ID);
+
+    ret = sensor_write_data(state, cmd, G2R_GET_PROPERTY_CMD_LEN);
+    if (ret < 0) {
+        dev_err(&state->client->dev, "i2c write get current work mode cmd err\n");
+        return ret;
+    }
+    
+    dev_dbg(&state->client->dev, "write current work mode cmd success\n");
+
+    usleep_range(100, 120);
+
+    ret = sensor_read_data(state, cmd, G2R_GET_CUR_WORK_MODE_LEN);
+    if (ret < 0) {
+        dev_err(&state->client->dev, "i2c read get current work mode rsp err\n");
+        return ret;
+    }
+    dev_dbg(&state->client->dev,
+             "read current work mode rsp success, expect_len=%u\n",
+             G2R_GET_CUR_WORK_MODE_LEN);
+
+    res_code = orb_get_le16((u8 *)&cmd->msg_body1.res);
+    version = orb_get_le16(&cmd->msg_body1.data[0]);
+    dev_dbg(&state->client->dev,
+             "current work mode rsp: res=0x%04x version=0x%04x\n",
+             res_code, version);
+
+    if (res_code != 0) {
+        dev_warn(&state->client->dev,
+                "get current work mode failed, res=0x%04x\n",
+                res_code);
+        // return -EIO;
+    }
+
+    if (version != WORK_MODE_DESC_VER) {
+        dev_warn(&state->client->dev,
+                 "work mode version mismatch: got=0x%04x expect=0x%04x\n",
+                 version, WORK_MODE_DESC_VER);
+    }
+
+
+    memcpy(&mode, &cmd->msg_body1.data[2], sizeof(orbbec_work_mode_desc));
+
+    /* Ensure null-termination (firmware may not guarantee it) */
+    mode.desc[WORK_MODE_DESC_STR_LEN - 1] = '\0';
+
+    strscpy(desc, mode.desc, desc_size);
+
+    dev_dbg(&state->client->dev,
+             "current work mode desc=[%s]\n",
+             desc);
+
+    dev_dbg(&state->client->dev,
+             "current work mode hash=%*ph\n",
+             WORK_MODE_HASH_CODE_LEN, mode.hash);
+
+    dev_dbg(&state->client->dev,
+             "current work mode dev_option: upsample_en=%u bypass_ref=%u orig_ir_streams=%u rectify_out_mirror_state=%u interleave_stream_state=%u mipi_channel_status=%u custom_preset_flag=%u\n",
+             mode.dev_option.upsample_en,
+             mode.dev_option.bypass_ref,
+             mode.dev_option.orig_ir_streams,
+             mode.dev_option.rectify_out_mirror_state,
+             mode.dev_option.interleave_stream_state,
+             mode.dev_option.mipi_channel_status,
+             mode.dev_option.custom_preset_flag);
+
+    dev_dbg(&state->client->dev, "finish get current work mode desc\n");
+
+    return 0;
+}
