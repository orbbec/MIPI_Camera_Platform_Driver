+int orbbec_device_info_cache_get(struct orb *state)
+{
+    struct orbbec_device_info_cache *cache;
+
+    if (!state || !state->dser_dev)
+        return -EINVAL;
+
+    mutex_lock(&orbbec_device_info_caches_lock);
+    list_for_each_entry(cache, &orbbec_device_info_caches, list) {
+        if (cache->dser_dev == state->dser_dev &&
+            cache->dser_link == state->dser_link) {
+            cache->users++;
+            state->device_info_cache = cache;
+            mutex_unlock(&orbbec_device_info_caches_lock);
+            return 0;
+        }
+    }
+
+    cache = kzalloc(sizeof(*cache), GFP_KERNEL);
+    if (!cache) {
+        mutex_unlock(&orbbec_device_info_caches_lock);
+        return -ENOMEM;
+    }
+
+    mutex_init(&cache->lock);
+    cache->dser_dev = state->dser_dev;
+    cache->dser_link = state->dser_link;
+    cache->users = 1;
+    list_add(&cache->list, &orbbec_device_info_caches);
+    state->device_info_cache = cache;
+    mutex_unlock(&orbbec_device_info_caches_lock);
+
+    return 0;
+}
+
+void orbbec_device_info_cache_put(struct orb *state)
+{
+    struct orbbec_device_info_cache *cache;
+
+    if (!state || !state->device_info_cache)
+        return;
+
+    mutex_lock(&orbbec_device_info_caches_lock);
+    cache = state->device_info_cache;
+    state->device_info_cache = NULL;
+    if (--cache->users == 0) {
+        list_del(&cache->list);
+        mutex_unlock(&orbbec_device_info_caches_lock);
+        mutex_destroy(&cache->lock);
+        kfree(cache);
+        return;
+    }
+    mutex_unlock(&orbbec_device_info_caches_lock);
+}
+
+void orbbec_device_info_cache_invalidate(struct orb *state)
+{
+    struct orbbec_device_info_cache *cache;
+
+    if (!state || !state->device_info_cache)
+        return;
+
+    cache = state->device_info_cache;
+    mutex_lock(&cache->lock);
+    cache->valid = false;
+    mutex_unlock(&cache->lock);
+}
