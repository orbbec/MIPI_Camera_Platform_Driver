+#else
+    if(!(priv->pipes_map & (1<<dst_vc_id))) {
+        priv->pipes_map |= (1<<dst_vc_id);
+        pipe_id = dst_vc_id;
+    }
+#endif
+
+    mutex_unlock(&priv->lock);
+
+    dev_info(dev, "request pipe id, %x\n", dst_vc_id);
+
