+static int orbbec_get_imu_stock(struct orb *state, int *data)
+{
+    int ret = 0, i = 0;
+    u16 cmd_index;
+    struct orbbec_cmd *cmd = &state->orbbec_cmd_buffer;
+
+    /* Clear the buffer before use */
+    memset(cmd, 0, sizeof(struct orbbec_cmd));
+
+    cmd->header.len = G2R_GET_IMU_STOCK_CMD_LEN;
+    cmd->header.code = G2R_GET_IMU_STOCK_CODE;
+    cmd->header.index = orb_cmd_index++;
+    cmd->_data[0] = 0xcd;
+    cmd->_data[1] = 0x0f;
+
+    cmd_index = cmd->header.index;
+    ret = sensor_write_data(state, cmd, G2R_GET_IMU_STOCK_CMD_LEN);
+    if(ret < 0) {
+        dev_err(&state->client->dev, "i2c write get_imu_stock cmd err\n");
+        goto err_5;
+    }
+    for(i = 0; i <= ORBBEC_I2C_RETRY_CNT; i++) {
+        usleep_range(100,120);
+        ret = sensor_read_data(state, cmd, G2R_GET_IMU_STOCK_LEN);
+        if(ret < 0) {
+            dev_err(&state->client->dev, "i2c read  imu_stock data err\n");
+            goto err_5;
+        }
+        
+        if(cmd->header.len != G2R_GET_IMU_STOCK_LEN || cmd->header.code != G2R_GET_IMU_STOCK_CODE || cmd->header.index != cmd_index) {
+            dev_info(&state->client->dev, "retry get_imustock\n");
+            continue;
+        } else {
+            break;
+        }
+    }
+    memcpy(data, cmd->msg_body.data, 4);
+    *data = *data/G2R_GET_IMU_DATA_LEN;
+err_5:
+    return ret;
+}
+
+static int orbbec_get_imu_data(struct orb *state, void * data)
+{
+    int ret = 0, stock_size = 0, get_imu_date_len = 0, i = 0;
+    u16 cmd_index;
+    struct orbbec_cmd *cmd = &state->orbbec_cmd_buffer;
+
+    ret = orbbec_get_imu_stock(state, &stock_size);
+    if(ret < 0) {
+        dev_err(&state->client->dev, "orbbec_get_imu_stock err\n");
+        goto err_9;
+    }
+
+    /* Clear the buffer before use */
+    memset(cmd, 0, sizeof(struct orbbec_cmd));
+
+    get_imu_date_len = G2R_GET_IMU_DATA_LEN*stock_size;
+    cmd->header.len = G2R_GET_IMU_DATA_CMD_LEN;
+    cmd->header.code = G2R_GET_IMU_DATA_CODE;
+    cmd->header.index = orb_cmd_index++;
+    cmd->_data[0] = 0xcd;
+    cmd->_data[1] = 0x0f;
+    cmd->_data[2] = 0x0;
+    cmd->_data[3] = 0x0;
+    cmd->_data[4] = 0x0;
+    cmd->_data[5] = 0x0;
+    cmd->_data[6] = 0x0;
+    cmd->_data[7] = 0x0;
+    cmd->_data[8] = get_imu_date_len;
+    cmd->_data[9] = get_imu_date_len >> 8;
+    cmd->_data[10] = get_imu_date_len >> 16;
+    cmd->_data[11] = get_imu_date_len >> 24;
+
+    cmd_index = cmd->header.index;
+
+    if(stock_size == 0 || stock_size < 0 || stock_size > G2R_IMU_STOCK_MAX_SIZE) {
+        cmd->header.len = G2R_I2C_RESPONSE_HEARD_LEN;
+        cmd->_data[0] = 0;
+        cmd->_data[1] = 0;
+        get_imu_date_len = 0;
+        dev_info(&state->client->dev, " stock_size = %d \n",stock_size);
+        dev_err(&state->client->dev, "orbbec stock size err\n");
+    } else {
+        ret = sensor_write_data(state, cmd, G2R_GET_IMU_DATA_CMD_LEN);
+        if(ret < 0) {
+            dev_err(&state->client->dev, "i2c write get_imudata_cmd cmd err\n");
+            goto err_9;
+        }
+        for(i = 0; i <= ORBBEC_I2C_RETRY_CNT; i++) {
+            usleep_range(100,120);
+            ret = sensor_read_data(state, cmd, G2R_I2C_RESPONSE_HEARD_LEN + get_imu_date_len);
+            if(ret < 0) {
+                dev_err(&state->client->dev, "i2c read imudata err\n");
+                goto err_9;
+            }
+            if(cmd->header.len == 0 && cmd->header.code == 0 && cmd->header.index == 0) {
+                dev_warn(&state->client->dev, "retry get_imudata\n");
+                continue;
+            }
+            else if(cmd->header.len != G2R_I2C_RESPONSE_HEARD_LEN + get_imu_date_len || cmd->header.code != G2R_GET_IMU_DATA_CODE || cmd->header.index != cmd_index) {
+                cmd->header.len = G2R_I2C_RESPONSE_HEARD_LEN;
+                cmd->_data[0] = 0;
+                cmd->_data[1] = 0;
+                get_imu_date_len = 0;
+                dev_err(&state->client->dev, " get_imudata data err\n");
+                break;
+            } else {
+                break;
+            }
+        }
+    }
+    
+    memcpy(data, cmd, G2R_I2C_RESPONSE_HEARD_LEN + get_imu_date_len);
+err_9:
+    return ret;
+}
