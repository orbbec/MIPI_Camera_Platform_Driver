+/* Parse and print version info */
+void parse_and_print_version_info(struct orb *state, struct orbbec_cmd *cmd)
+{
+    orbbec_device_version_info *info;
+
+    /* Check if data length is sufficient */
+    if (cmd->header.len != G2R_GET_VERSION_DATA_LEN) {
+        dev_err(&state->client->dev, "version data too short: %d bytes\n", 
+                cmd->header.len);
+        return;
+    }
+
+    info = (orbbec_device_version_info *)(cmd->msg_body1.data);
+
+    dev_info(&state->client->dev, "========== Orbbec GMSL Camera Info ==========\n");
+    dev_info(&state->client->dev, "  Device Name:      %s\n", info->device_name);
+    dev_info(&state->client->dev, "  Device Type:      %d\n", info->device_type);
+    dev_info(&state->client->dev, "  Firmware Version: %s\n", info->firmware_version);
+    dev_info(&state->client->dev, "  Hardware Version: %s\n", info->hardware_version);
+    dev_info(&state->client->dev, "  SDK Version:      %s\n", info->sdk_version);
+    dev_info(&state->client->dev, "  Depth Chip:       %s\n", info->depth_chip);
+    dev_info(&state->client->dev, "  System Chip:      %s\n", info->system_chip);
+    dev_info(&state->client->dev, "  Serial Number:    %s\n", info->serial_number);
+    dev_info(&state->client->dev, "  SubSystem Version:%s\n", info->sub_system_version);
+    dev_info(&state->client->dev, "=============================================\n");
+}
