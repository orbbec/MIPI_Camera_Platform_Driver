+#define UPDATE_GMSL_STATUS(_status, _cond, _flag, _set) \
+    do { \
+        if ((_cond) == (_set)) { \
+            *(_status) |= (_flag); \
+        } else { \
+            *(_status) &= ~(_flag); \
+        } \
+    } while (0)
+
+// Link A-D decode error register address table
+static const u16 g_dec_err_reg_tab[] = {
+    [ORB_LINKA] = MAX96712_DEC_ERR_A_ADDR,
+    [ORB_LINKB] = MAX96712_DEC_ERR_B_ADDR,
+    [ORB_LINKC] = MAX96712_DEC_ERR_C_ADDR,
+    [ORB_LINKD] = MAX96712_DEC_ERR_D_ADDR,
+};
+
+/**
+ * max96712_get_gmsl_status - Get MAX96712 deserializer GMSL status
+ * @dev: deserializer device (orb->dser_dev)
+ * @cam_type: camera type (orb_cam_type_e)
+ * @link_id: GMSL link ID (ORB_LINKA~D, orb->dser_link)
+ * @pipe_id: PIPE ID (GMSL data channel)
+ * @status: output param, all GMSL status bits (64-bit), must be initialized
+ *
+ * Implements orb_deser_ops->get_gmsl_status
+ */
+int max96712_get_gmsl_status(struct device *dev, orb_cam_type_e cam_type,
+                             u8 link_id, u8 pipe_id, __u64 *status)
+{
+    struct max96712 *priv = dev_get_drvdata(dev);
+    const struct cam_status_bits *status_bits;
+    int ret = 0;
+    u8 val;
+    int link_state;
+
+    if (!dev || !status || !priv || cam_type >= ORB_CAM_TYPE_COUNT ||
+        link_id >= MAX96712_MAX_LINKS || link_id >= ARRAY_SIZE(g_dec_err_reg_tab) ||
+        pipe_id >= MAX96712_MAX_PIPES) {
+        dev_err(dev, "invalid param: dev=%p priv=%p cam=%d link=%d pipe=%d\n",
+                dev, priv, cam_type, link_id, pipe_id);
+        return -EINVAL;
+    }
+
+    status_bits = &g_cam_status_map[cam_type];
+
+    // Pipe ID adaptation: adjust when Port B is not connected
+    if (priv->is_port_b_connected == 0 && priv->csi_mode == MAX96712_CSI_MODE_2X4 && pipe_id >= CSI_VC_MAX_NUMS) {
+        pipe_id -= CSI_VC_MAX_NUMS;
+        dev_dbg(dev, "port B disconnected, pipe_id adjusted to %d\n", pipe_id);
+    }
+
+    // Read link lock status
+
+    ret = max96712_get_link_state(dev, link_id, &link_state);
+
+    if (ret < 0) {
+        dev_err(dev, "get link %d state failed, all %d retries done (ret=%d)\n",
+                link_id, ORBBEC_I2C_RETRY_CNT, ret);
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    } else {
+        // Update link lock status: locked -> clear unlock bit, unlocked -> set unlock bit
+        UPDATE_GMSL_STATUS(status, link_state, GMSL_STATUS_LINK_UNLOCKED, 0);
+        dev_dbg(dev, "LINK %d %s\n", link_id, link_state ? "LOCKED" : "UNLOCKED");
+        if (!link_state) {
+            dev_warn(dev, "LINK %d UNLOCKED\n", link_id);
+        }
+    }
+
+    // Read SER PIPE status
+    ret = max96712_read_reg_with_addr(dev, TO_SERI_ADDR(link_id), g_ser_pipe_status_addr_tab[pipe_id], &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d SER pipe status:0x%04x = 0x%02x\n", link_id, cam_type, g_ser_pipe_status_addr_tab[pipe_id], val);
+        UPDATE_GMSL_STATUS(status, (val & SER_PIPE_PCLK_DET_BIT), status_bits->pclk_undetected, 0);
+        UPDATE_GMSL_STATUS(status, (val & SER_PIPE_DRIFT_ERR_BIT), status_bits->drift_err, 1);
+        UPDATE_GMSL_STATUS(status, (val & SER_PIPE_OVERFLOW_BIT), status_bits->overflow, 1);
+    }
+
+    // Read DESER PIPE status
+    ret = max96712_read_reg(dev, g_deser_pipe_status_addr_tab[pipe_id], &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d DESER pipe status:0x%04x = 0x%02x\n", link_id, cam_type, g_deser_pipe_status_addr_tab[pipe_id], val);
+        UPDATE_GMSL_STATUS(status, (val & DESER_PIPE_VID_LOCK_BIT), status_bits->vid_unlock, 0);
+        UPDATE_GMSL_STATUS(status, (val & DESER_PIPE_PKT_DET_BIT), status_bits->pkt_undetected, 0);
+    } else {
+        dev_err(dev, "read DESER pipe status failed, ret=%d\n", ret);
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    // Read DESER PIPE CRC status
+    ret = max96712_read_reg(dev, g_deser_pipe_crc_status_addr_tab[pipe_id], &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d DESER CRC status:0x%04x = 0x%02x\n", link_id, cam_type, g_deser_pipe_crc_status_addr_tab[pipe_id], val);
+        UPDATE_GMSL_STATUS(status, (val & DESER_PIPE_LINE_CRC_BIT), status_bits->line_crc_err, 1);
+    } else {
+        dev_err(dev, "read DESER pipe CRC status failed, ret=%d\n", ret);
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    // Read BACKTOP25 - line memory error status
+    ret = max96712_read_reg(dev, MAX96712_BACKTOP25_ADDR, &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d BACKTOP25:0x%04x = 0x%02x\n", link_id, cam_type, MAX96712_BACKTOP25_ADDR, val);
+        UPDATE_GMSL_STATUS(status, (val & (MAX96712_LINE_MEM_ERR_BIT << pipe_id)), status_bits->line_mem_err, 1);
+    } else {
+        dev_err(dev, "read BACKTOP25 failed, ret=%d\n", ret);
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    // Read BACKTOP1 - CSI PLL lock status
+    ret = max96712_read_reg(dev, MAX96712_BACKTOP1_ADDR, &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d BACKTOP1:0x%04x = 0x%02x\n", link_id, cam_type, MAX96712_BACKTOP1_ADDR, val);
+        if (priv->csi_mode == MAX96712_CSI_MODE_2X4) {
+            if (priv->is_port_b_connected)
+                UPDATE_GMSL_STATUS(status, (val & (MAX96712_CSIPLL_LOCK_BIT << ((link_id > 1) ? 2 : 1))), GMSL_STATUS_MIPI_PLL_UNLOCKED, 0);
+            else
+                UPDATE_GMSL_STATUS(status, (val & (MAX96712_CSIPLL_LOCK_BIT << 1)), GMSL_STATUS_MIPI_PLL_UNLOCKED, 0);
+        } else {
+            if (priv->is_port_b_connected)
+                UPDATE_GMSL_STATUS(status, (val & (MAX96712_CSIPLL_LOCK_BIT << link_id)), GMSL_STATUS_MIPI_PLL_UNLOCKED, 0);
+            else
+                UPDATE_GMSL_STATUS(status, (val & (MAX96712_CSIPLL_LOCK_BIT << ((link_id > 1) ? 1 : 0))), GMSL_STATUS_MIPI_PLL_UNLOCKED, 0);
+        }
+    } else {
+        dev_err(dev, "read BACKTOP1 failed, ret=%d\n", ret);
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    // Read MIPI_PHY11 - FIFO overflow/underflow status
+    ret = max96712_read_reg(dev, MAX96712_MIPI_PHY11_ADDR, &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d MIPI_PHY20:0x%04x = 0x%02x\n", link_id, cam_type, MAX96712_MIPI_PHY11_ADDR, val);
+        UPDATE_GMSL_STATUS(status, ((val & MAX96712_MIPI_PHY_COPY0_OVERFLOW_STATUS_BIT) || \
+                                    (val & MAX96712_MIPI_PHY_COPY1_OVERFLOW_STATUS_BIT)), GMSL_STATUS_MIPI_FIFO_OVERFLOW, 1);
+        UPDATE_GMSL_STATUS(status, ((val & MAX96712_MIPI_PHY_COPY0_UNDERFLOW_STATUS_BIT) || \
+                                    (val & MAX96712_MIPI_PHY_COPY1_UNDERFLOW_STATUS_BIT)), GMSL_STATUS_MIPI_FIFO_UNDERFLOW, 1);
+    } else {
+        dev_err(dev, "read MIPI_PHY11 failed, ret=%d\n", ret);
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    ret = max96712_read_reg(dev, MAX96712_DEC_ERR_FLG_ADDR, &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d DEC_ERR_FLG:0x%04x = 0x%02x\n", link_id, cam_type, MAX96712_DEC_ERR_FLG_ADDR, val);
+        if (val & (MAX96712_DEC_ERR_FLG_BIT << link_id)) {
+            ret = max96712_read_reg(dev, g_dec_err_reg_tab[link_id], &val);
+            if (!ret) {
+                dev_info(dev, "link%d cam%d DEC_ERR:0x%04x = 0x%02x\n", link_id, cam_type, g_dec_err_reg_tab[link_id], val);
+                UPDATE_GMSL_STATUS(status, (val > 0), GMSL_STATUS_LINK_DEC_ERR, 1);
+            }
+        } else {
+            UPDATE_GMSL_STATUS(status, 0, GMSL_STATUS_LINK_DEC_ERR, 1);
+        }
+    } else {
+        dev_err(dev, "read DEC_ERR_FLG failed, ret=%d\n", ret);
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    // Read INTR5_FLG - EOM error status
+    ret = max96712_read_reg(dev, MAX96712_INTR5_FLG_ADDR, &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d INTR5_FLG:0x%04x = 0x%02x\n", link_id, cam_type, MAX96712_INTR5_FLG_ADDR, val);
+        UPDATE_GMSL_STATUS(status, (val & (MAX96712_LINKA_EOM_ERR_FLG_BIT << link_id)), GMSL_STATUS_LINK_EOM_ERR_FLAG, 1);
+    } else {
+        dev_err(dev, "read INTR5_FLG failed, ret=%d\n", ret);
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    // Read CTRL3 - ERRB status
+    ret = max96712_read_reg(dev, MAX96712_CTRL3_ADDR, &val);
+    if (!ret) {
+        dev_info(dev, "link%d cam%d CTRL3:0x%04x = 0x%02x\n", link_id, cam_type, MAX96712_CTRL3_ADDR, val);
+        UPDATE_GMSL_STATUS(status, (val & MAX96712_ERRB_ASSERTED), GMSL_STATUS_DESER_ERRB_ASSERTED, 1);
+    } else {
+        dev_err(dev, "read CTRL3 failed, ret=%d\n", ret);
+        *status |= GMSL_STATUS_DESER_I2C_STATUS_ERR;
+    }
+
+    return ret;
+}
+EXPORT_SYMBOL(max96712_get_gmsl_status);
+
+int max96712_get_available_pipe_id(struct device *dev, int dst_vc_id)
