+/* Read device info from orbbec camera via I2C
+ * state: pointer to global orb state struct
+ * data: buffer to store read data
+ * cmd_len: command length
+ * opcode: operation code
+ * pro_id: property id
+ * data_len: data length to read
+ * Return: -1 on error, 0 on success
+ */
+static int orbbec_get_dev_info(struct orb *state, void * data, uint16_t cmd_len, uint16_t opcode, uint16_t pro_id, uint32_t data_len)
+{
+    int ret = 0, i = 0;
+    struct orbbec_cmd *cmd = &state->orbbec_cmd_buffer;
+
+    /* Clear the buffer before use */
+    memset(cmd, 0, sizeof(struct orbbec_cmd));
+
+    cmd->header.len = cmd_len;
+    cmd->header.code = opcode;
+    cmd->header.index = orb_cmd_index++;
+    cmd->_data[0] = pro_id;
+    cmd->_data[1] = pro_id >>8;
+
+    ret = sensor_write_data(state, cmd, cmd_len);
+    if(ret < 0) {
+        dev_err(&state->client->dev, "i2c write get_dev_info cmd err (ret=%d)\n", ret);
+        goto err_11;
+    }
+retry:
+    msleep(2);
+    ret = sensor_read_data(state, cmd, data_len);
+    if(cmd->header.len == 0 && cmd->header.code == 0 && cmd->header.index == 0 && i < ORBBEC_I2C_RETRY_CNT){
+        i++;
+        dev_err(&state->client->dev, "get_dev_info data err retry ...\n");
+        goto retry;
+    }
+    if(cmd->header.code != opcode){
+        dev_err(&state->client->dev, "get_dev_info data err\n");
+        goto err_11;
+    }
+    memcpy(data, cmd->msg_body1.data, data_len-G2R_I2C_RESPONSE_HEARD_LEN);
+err_11:
+    return ret;
+}
+
+int orbbec_get_deviceinfo(struct orb *state, void *vid, void *pid, void *sn, void *asic_sn)
+{
+    int ret = 0;
+
+    ret = orbbec_get_dev_info(state, vid, G2R_GET_FIRMWARE_DATA_CMD_LEN, G2R_GET_FIRMWARE_DATA_CODE, G2R_GET_VID_PRO_ID, G2R_GET_DATA_NOMAL_LEN);
+    if (ret < 0)
+        return ret;
+
+    // Fix VID if it's invalid (0x0000 or 0x6564 appears to be invalid)
+    if (*(u16*)vid == 0 || *(u16*)vid == 0x6564)
+        *(u16*)vid = 0x2bc5;
+
+    ret = orbbec_get_dev_info(state, pid, G2R_GET_PROPERTY_CMD_LEN, G2R_GET_PROPERTY_CODE, G2R_GET_PID_PRO_ID, G2R_GET_DATA_NOMAL_LEN);
+    if (ret < 0)
+        return ret;
+
+    ret = orbbec_get_dev_info(state, sn, G2R_GET_FIRMWARE_DATA_CMD_LEN, G2R_GET_FIRMWARE_DATA_CODE, G2R_GET_SN_PRO_ID, G2R_GET_SN_DATA_LEN);
+    if (ret < 0)
+        return ret;
+
+    ret = orbbec_get_dev_info(state, asic_sn, G2R_GET_FIRMWARE_DATA_CMD_LEN, G2R_GET_FIRMWARE_DATA_CODE, G2R_GET_ASIC_SN_PRO_ID, G2R_GET_SN_DATA_LEN);
+
+    return ret;
+}
