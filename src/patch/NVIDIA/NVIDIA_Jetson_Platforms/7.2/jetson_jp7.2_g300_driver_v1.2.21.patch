+#include <linux/types.h>
+
+#ifndef _OBC_G300_PRIV_H_
+#define _OBC_G300_PRIV_H_
+
+#define ORBBEC_GMSL_CAMERA_DRIVER_VERSION "1.2.21(JP7.2)"
+#define CONFIG_TEGRA_CAMERA_PLATFORM  1
+
+//---------------------------------------------------------------------------
+#define MAX_I2C_PACKET_SIZE 	240
+
+#define ORB_FORMARS_MAX     	5
+#define ORB_RESOLUTIONS_MAX    	30
+
+#define ORB_METADATA_IN_IMAGE_FIRST_ROW 		1
+#define ORB_METADATA_IN_EMB 		            0
+#define MAX9296_MAX_LINKS   2
+#define MAX96712_MAX_LINKS  4
+
+#define GEMINI_335LG_PID    0x080B
+#define GEMINI_338LG_PID    0x081A  //
+#define CAM_5530_PID        0x0819  //
+
+#define GEMINI_345LG_PID    0x0813
+#define DABAI_AL_PID        0x0A13
+
+#define GEMINI_305G_PID     0x0842
+#define GEMINI_301G_PID     0x0843
+#define GEMINI_309G_PID     0x0845 //
+
+#define ORBBEC_BOOT_PID     0x0501
+
+//---------------------------------------------------------------------------
+#define GEMINI_305G_SERIES_PID(pid) \
+    (((pid) >= 0x0842 && (pid) <= 0x0845) || \
+     ((pid) >= 0x0868 && (pid) <= 0x086B))
+
+#define GEMINI_335LG_SERIES_PID(pid) \
+    (((pid) >= 0x080B && (pid) <= 0x080D) || \
+     ((pid) >= 0x0819 && (pid) <= 0x081A) || \
+     ((pid) >= 0x0860 && (pid) <= 0x0867) || \
+     ((pid) >= 0x800C && (pid) <= 0x800D) || \
+     ((pid) == 0x8004))
+
+#define GEMINI_345LG_SERIES_PID(pid) \
+    (((pid) == GEMINI_345LG_PID) || \
+     ((pid) == DABAI_AL_PID) || \
+     ((pid) >= 0x086C && (pid) <= 0x086F) || \
+     ((pid) >= 0x0A20 && (pid) <= 0x0A23))
+
+//---------------------------------------------------------------------------
+#define SERIALIZER_PIPE_U_SELECT 		0x8
+#define SERIALIZER_PIPE_Z_SELECT 		0x4
+#define SERIALIZER_PIPE_Y_SELECT 		0x2
+#define SERIALIZER_PIPE_X_SELECT 		0x1
+#define SERIALIZER_PIPE_NO_SELECT 		0x0
+
+#define ORBBEC_I2C_RETRY_CNT		10      // 最大重试次数（含首次）
+#define ORBBEC_I2C_RETRY_DELAY      10      // 重试间隔（毫秒），可选配置
+#define MAX9296A_RETRY_DELAY_US   	100     // 重试间隔（微秒）
+#define MAX96712_RETRY_DELAY_US   	100     // 重试间隔（微秒）
+
+#define WORK_MODE_HASH_CODE_LEN 16 // bytes, MD5/SHA1
+#define WORK_MODE_DESC_STR_LEN 32
+#define WORK_MODE_DESC_VER 0x0000
+
+
+struct orbbec_header {
+	u16 len;
+    u16 code;
+    u16 index;
+};
+
+struct orbbec_msg_body {
+	uint16_t res;
+	uint16_t prop_ver;
+    uint8_t  data[MAX_I2C_PACKET_SIZE - 4];
+};
+
+struct orbbec_msg_body1 {
+	uint16_t res;
+    uint8_t  data[MAX_I2C_PACKET_SIZE - 2];
+};
+
+struct orbbec_set_imu_cmd {
+	uint16_t prop_code0;
+	uint16_t prop_code1;
+	uint16_t value0;
+	uint16_t value1;
+};
+
+struct orbbec_set_stream_cmd {
+	uint8_t stream_type;
+	uint8_t res;
+	uint8_t format;
+	uint8_t fps;
+};
+
+struct orbbec_cmd {
+	struct orbbec_header header;
+	union {
+		uint8_t _data[MAX_I2C_PACKET_SIZE];
+        struct orbbec_msg_body msg_body;
+		struct orbbec_msg_body1 msg_body1;
+		struct orbbec_set_stream_cmd set_stream_cmd;
+		struct orbbec_set_imu_cmd set_imu_cmd;
+	};
+};
+
+struct orbbec_device_info {
+	uint16_t vid;
+	uint16_t pid;
+	uint8_t  sn[16];
+    uint8_t  asic_sn[16];
+	uint16_t video_type;
+	uint16_t sub_num;
+	uint32_t cam_num;
+};
+
+typedef struct {
+    char    firmware_version[16];   /* Firmware version number */
+    char    hardware_version[16];   /* Hardware version number */
+    char    sdk_version[16];        /* Minimum supported SDK version number */
+    char    depth_chip[16];         /* Depth chip model */
+    char    system_chip[16];        /* System chip model */
+    char    serial_number[16];      /* Serial number */
+    int32_t device_type;            /* Device type */
+    char    device_name[16];        /* Device name */
+    char    sub_system_version[16];  /* Subsystem version number */
+    char    reserved[32];          /* Reserved field */
+} orbbec_device_version_info;
+
+typedef struct
+{
+    uint32_t upsample_en:1;
+    uint32_t bypass_ref:1;
+    uint32_t orig_ir_streams:1;
+    uint32_t rectify_out_mirror_state:1;
+    uint32_t interleave_stream_state:1;
+    uint32_t mipi_channel_status:1;
+    uint32_t custom_preset_flag:1;
+    uint32_t reserved:25;
+} orbbec_dev_option;
+
+typedef struct work_mode_desc {
+    uint8_t hash[WORK_MODE_HASH_CODE_LEN];
+    uint8_t desc[WORK_MODE_DESC_STR_LEN];
+    orbbec_dev_option dev_option;
+} orbbec_work_mode_desc;
+
+//---------------------------------------------------------------------------
