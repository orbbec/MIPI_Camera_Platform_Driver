+/* Get readable sensor name */
+static const char *orb_get_sensor_name(struct orb *state)
+{
+    static const char *sensor_name[] = {"DEPTH", "RGB", "IR_L", "IR_R"};
+    return sensor_name[state->cam_type];
+}
